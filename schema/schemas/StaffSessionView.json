{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/StaffSessionView.json",
  "$ref": "#/$defs/StaffSessionView",
  "$defs": {
    "AlertKind": {
      "oneOf": [
        {
          "const": "RISK_STOP"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "USER_CALLED_STAFF"
        }
      ],
      "description": "공개 알림 종류 이름. 목록 StaffAlert와 세션 보기가 같은 이름을 쓴다(PUBLIC_API.md 2.2.0). 내부 위험 알림 종류 RISK는 공개할 때 RISK_STOP이다."
    },
    "SessionId": {
      "type": "string",
      "minLength": 1
    },
    "SessionStatus": {
      "oneOf": [
        {
          "const": "IN_PROGRESS"
        },
        {
          "const": "PAUSED_RISK"
        },
        {
          "const": "ENDED_COMPLETE"
        },
        {
          "const": "ENDED_STAFF"
        },
        {
          "const": "ENDED_LEFT"
        },
        {
          "const": "ENDED_USER_STOP"
        }
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC ISO 8601, 초 단위, 끝에 Z."
    },
    "StaffSessionView": {
      "type": "object",
      "description": "GET /v1/staff/sessions/{session_id}의 응답. 직원이 세션의 대화 기록과 저장된 값을 읽는다(읽기 전용). 세션 문서(SessionStore)와 직원 알림 저장소에서 만든다. 세션 문서에 시각이 없어 서비스가 따로 남긴 시각이 없는 항목(이 기능 이전의 세션)은 turn_id·at·created_at이 null이다.",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StaffTurn"
          }
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StaffValue"
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StaffViewAlert"
          }
        },
        "subject_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "pause_reason": {
          "description": "정지 사유(2.1.0, CR-H002). 위험 신호/위험 규칙은 RISK, 되묻기 한도 초과는 REASK_LIMIT, 그 밖은 OTHER. optional: 없으면 미상. 읽는 쪽은 모르는 값을 OTHER로 취급한다.",
          "oneOf": [
            {
              "const": "RISK"
            },
            {
              "const": "REASK_LIMIT"
            },
            {
              "const": "OTHER"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "subject_ref",
        "status",
        "release_id",
        "created_at",
        "turns",
        "values",
        "alerts"
      ],
      "additionalProperties": false
    },
    "StaffTurn": {
      "type": "object",
      "description": "대화 로그 한 항목. turn_index는 로그의 위치(0부터). 시작·종료·개입 항목은 utterance가 null일 수 있다.",
      "properties": {
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "utterance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "turn_index",
        "turn_id",
        "at",
        "utterance",
        "response_text",
        "action"
      ],
      "additionalProperties": false
    },
    "StaffValue": {
      "type": "object",
      "description": "저장된 값 한 칸(값이 없는 칸은 나오지 않는다). key는 모델 키(Q7_1[soju].amount). status는 ANSWERED, 정정된 적이 있으면 CORRECTION.",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "status": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "type": "string",
          "enum": [
            "exact",
            "approximate",
            "unspecified"
          ]
        }
      },
      "required": [
        "key",
        "value",
        "status",
        "precision"
      ],
      "additionalProperties": false
    },
    "StaffViewAlert": {
      "type": "object",
      "description": "직원 알림. rule_id는 위험 규칙 엔진이 낸 알림에만 있고 나머지는 null(발화 원문이 아니다).",
      "properties": {
        "alert_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/AlertKind"
        },
        "status": {
          "enum": [
            "OPEN",
            "RESOLVED"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "알림을 해결한 직원 계정 ID. 열려 있거나 개입 없이(이탈 등) 해결됐으면 null."
        },
        "pause_reason": {
          "description": "정지 사유(2.1.0, CR-H002). 위험 신호/위험 규칙은 RISK, 되묻기 한도 초과는 REASK_LIMIT, 그 밖은 OTHER. optional: 없으면 미상. 읽는 쪽은 모르는 값을 OTHER로 취급한다.",
          "oneOf": [
            {
              "const": "RISK"
            },
            {
              "const": "REASK_LIMIT"
            },
            {
              "const": "OTHER"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "last_delivery_status": {
          "enum": [
            "DELIVERED",
            "DELIVERY_FAILED",
            null
          ]
        },
        "manual_notice_outcome": {
          "enum": [
            "STAFF_NOTIFIED_MANUALLY",
            "NOT_NOTIFIED",
            null
          ]
        },
        "manual_notice_reported_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alert_id",
        "kind",
        "status",
        "created_at",
        "rule_id",
        "resolved_by"
      ],
      "additionalProperties": false
    },
    "SubjectRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/#=+-]{1,128}$",
      "description": "병원이 정한 불투명 환자·방문 참조."
    }
  }
}
