{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/AnswerJudgeInput.json",
  "$ref": "#/$defs/AnswerJudgeInput",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "const": "ASK_NEXT"
        },
        {
          "const": "ASK_MISSING"
        },
        {
          "const": "ASK_CLARIFY"
        },
        {
          "const": "ASK_CONFIRM"
        },
        {
          "const": "ASK_AFTER_UNKNOWN"
        },
        {
          "const": "ASK_AFTER_REFUSAL"
        },
        {
          "const": "ASK_CORRECTION_TARGET"
        },
        {
          "const": "ASK_FINISH"
        },
        {
          "const": "ASK_STOP"
        },
        {
          "const": "ASK_REPEAT"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "REDIRECT"
        },
        {
          "const": "RISK_NOTICE"
        },
        {
          "const": "WAIT_NOTICE"
        },
        {
          "const": "STAFF_NOTICE"
        },
        {
          "const": "FAREWELL"
        }
      ]
    },
    "AnswerJudgeInput": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        },
        "item_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemCheck"
          }
        },
        "missing_required_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          }
        },
        "utterance": {
          "type": "string"
        },
        "risk_phrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "last_directive": {
          "anyOf": [
            {
              "$ref": "#/$defs/Directive"
            },
            {
              "type": "null"
            }
          ]
        },
        "pendings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pending_id": {
                "$ref": "#/$defs/PendingId"
              },
              "slot": {
                "$ref": "#/$defs/SlotRef"
              }
            },
            "required": [
              "pending_id",
              "slot"
            ],
            "additionalProperties": false
          }
        },
        "affected_followups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "followups": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/QuestionId"
                }
              }
            },
            "required": [
              "question_id",
              "followups"
            ],
            "additionalProperties": false
          }
        },
        "question_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "slot_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "question_id",
              "slot_ids"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items",
        "item_checks",
        "missing_required_slots",
        "utterance",
        "risk_phrases",
        "last_directive",
        "pendings",
        "affected_followups",
        "question_slots"
      ],
      "additionalProperties": false
    },
    "AskAction": {
      "oneOf": [
        {
          "const": "ASK_NEXT"
        },
        {
          "const": "ASK_MISSING"
        },
        {
          "const": "ASK_CLARIFY"
        },
        {
          "const": "ASK_CONFIRM"
        },
        {
          "const": "ASK_AFTER_UNKNOWN"
        },
        {
          "const": "ASK_AFTER_REFUSAL"
        },
        {
          "const": "ASK_CORRECTION_TARGET"
        },
        {
          "const": "ASK_FINISH"
        },
        {
          "const": "ASK_STOP"
        }
      ]
    },
    "AskDirective": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/AskAction"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          }
        },
        "target_pending_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingId"
            },
            {
              "type": "null"
            }
          ]
        },
        "say_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SayValue"
          }
        }
      },
      "required": [
        "action",
        "targets",
        "target_pending_id",
        "say_values"
      ],
      "additionalProperties": false
    },
    "CodedValue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "Directive": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          }
        },
        "target_pending_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingId"
            },
            {
              "type": "null"
            }
          ]
        },
        "awaiting": {
          "anyOf": [
            {
              "$ref": "#/$defs/AskDirective"
            },
            {
              "type": "null"
            }
          ]
        },
        "say_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SayValue"
          }
        },
        "reask_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "uniqueItems": true
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Notice"
          }
        },
        "sentence_materials": {
          "$ref": "#/$defs/SentenceMaterials"
        }
      },
      "required": [
        "action",
        "targets",
        "target_pending_id",
        "awaiting",
        "say_values",
        "reask_reasons",
        "notices",
        "sentence_materials"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "offset_unit": {
          "type": "string",
          "enum": [
            "unicode_code_point",
            "utf16_code_unit",
            "utf8_byte"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "turn_index",
        "start",
        "end",
        "offset_unit",
        "text"
      ],
      "additionalProperties": false
    },
    "FixedSentenceKey": {
      "oneOf": [
        {
          "const": "ASK_REPEAT"
        },
        {
          "const": "OOS_NOTICE"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "FAREWELL"
        },
        {
          "const": "ASK_CONFIRM"
        },
        {
          "const": "ASK_CORRECTION_TARGET"
        },
        {
          "const": "ASK_FINISH"
        },
        {
          "const": "RISK_NOTICE"
        },
        {
          "const": "RESUME"
        },
        {
          "const": "SURVEY_STOPPED"
        },
        {
          "const": "WAIT_NOTICE"
        },
        {
          "const": "ASK_STOP"
        },
        {
          "const": "STAFF_NOTICE"
        },
        {
          "const": "DEFERRED"
        }
      ]
    },
    "Intent": {
      "oneOf": [
        {
          "const": "ANSWERED_INTENT"
        },
        {
          "const": "CORRECTION_MARKED"
        },
        {
          "const": "CONFIRM_YES"
        },
        {
          "const": "CONFIRM_NO"
        },
        {
          "const": "SAYS_UNKNOWN"
        },
        {
          "const": "SAYS_REFUSAL"
        },
        {
          "const": "PROGRESS_OP"
        },
        {
          "const": "GUIDE_REQUEST"
        },
        {
          "const": "USER_CALLED_STAFF"
        },
        {
          "const": "OUT_OF_SCOPE"
        },
        {
          "const": "UNRECOGNIZED"
        },
        {
          "const": "RISK_SIGNAL"
        }
      ]
    },
    "Item": {
      "type": "object",
      "properties": {
        "item_no": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_text": {
          "$ref": "#/$defs/SourceText"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "progress_op": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgressOp"
            },
            {
              "type": "null"
            }
          ]
        },
        "guide_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextSpan"
          }
        }
      },
      "required": [
        "item_no",
        "target",
        "value",
        "source_text",
        "intent",
        "progress_op",
        "guide_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "intent": {
                "enum": [
                  "ANSWERED_INTENT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "not": {
                  "enum": [
                    null
                  ]
                }
              },
              "value": {
                "not": {
                  "enum": [
                    null
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "ItemCheck": {
      "type": "object",
      "properties": {
        "item_no": {
          "type": "integer",
          "minimum": 0
        },
        "standard_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Problem"
          },
          "uniqueItems": true
        },
        "mismatched_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          }
        },
        "vs_current": {
          "oneOf": [
            {
              "const": "EQUAL"
            },
            {
              "const": "DIFFERENT"
            },
            {
              "const": "NO_CURRENT"
            },
            {
              "const": "NOT_APPLICABLE"
            }
          ]
        },
        "vs_pending": {
          "oneOf": [
            {
              "const": "EQUAL"
            },
            {
              "const": "DIFFERENT"
            },
            {
              "const": "NO_PENDING"
            },
            {
              "const": "NOT_APPLICABLE"
            }
          ]
        },
        "risk_rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "prerequisite_unmet": {
          "type": "boolean"
        },
        "value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        },
        "problem_details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProblemDetail"
          }
        }
      },
      "required": [
        "item_no",
        "standard_value",
        "problems",
        "mismatched_slots",
        "vs_current",
        "vs_pending",
        "risk_rule",
        "prerequisite_unmet"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "value_metadata"
            ],
            "properties": {
              "value_metadata": {
                "properties": {
                  "precision": {
                    "enum": [
                      "exact",
                      "approximate"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "standard_value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "Notice": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/NoticeKind"
        },
        "guide_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "question_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/SlotRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        },
        "previous_value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        }
      },
      "required": [
        "kind",
        "guide_id",
        "question_id",
        "question_name",
        "slot",
        "previous_value",
        "value"
      ],
      "additionalProperties": false
    },
    "NoticeKind": {
      "oneOf": [
        {
          "const": "CORRECTION_ACK"
        },
        {
          "const": "KEPT_PREVIOUS"
        },
        {
          "const": "RESUME"
        },
        {
          "const": "SURVEY_STOPPED"
        },
        {
          "const": "GUIDE"
        },
        {
          "const": "DEFERRED"
        }
      ]
    },
    "PendingId": {
      "type": "string",
      "minLength": 1
    },
    "Precision": {
      "type": "string",
      "enum": [
        "exact",
        "approximate",
        "unspecified"
      ]
    },
    "Problem": {
      "oneOf": [
        {
          "const": "NO_UNIT"
        },
        {
          "const": "OUT_OF_RANGE"
        },
        {
          "const": "AMBIGUOUS"
        },
        {
          "const": "MISMATCH"
        },
        {
          "const": "UNKNOWN_TARGET"
        }
      ]
    },
    "ProblemDetail": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/Problem"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          }
        },
        "message": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "category",
        "code",
        "refs",
        "message"
      ],
      "additionalProperties": false
    },
    "ProgressOp": {
      "oneOf": [
        {
          "const": "REPEAT"
        },
        {
          "const": "WAIT"
        },
        {
          "const": "LATER"
        },
        {
          "const": "STOP"
        }
      ]
    },
    "QuestionId": {
      "type": "string",
      "minLength": 1
    },
    "Reason": {
      "oneOf": [
        {
          "const": "NO_UNIT"
        },
        {
          "const": "OUT_OF_RANGE"
        },
        {
          "const": "AMBIGUOUS"
        },
        {
          "const": "MISMATCH"
        },
        {
          "const": "UNRECOGNIZED"
        },
        {
          "const": "MISSING_SLOT"
        }
      ]
    },
    "RiskResponse": {
      "oneOf": [
        {
          "const": "IMMEDIATE"
        },
        {
          "const": "ON_RESULT"
        }
      ]
    },
    "SayValue": {
      "type": "object",
      "properties": {
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "question_name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/Value"
        },
        "role": {
          "oneOf": [
            {
              "const": "CURRENT"
            },
            {
              "const": "PENDING"
            },
            {
              "const": "JUST_SAVED"
            },
            {
              "const": "SAID"
            }
          ]
        },
        "value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        }
      },
      "required": [
        "slot",
        "question_name",
        "value",
        "role"
      ],
      "additionalProperties": false
    },
    "SentenceMaterials": {
      "type": "object",
      "properties": {
        "question_sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "question_id",
              "sentence"
            ],
            "additionalProperties": false
          }
        },
        "refusal_explanations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "question_id",
              "sentence"
            ],
            "additionalProperties": false
          }
        },
        "reask_sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "$ref": "#/$defs/SlotRef"
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "slot",
              "sentence"
            ],
            "additionalProperties": false
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "$ref": "#/$defs/SlotRef"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "slot",
              "choices"
            ],
            "additionalProperties": false
          }
        },
        "guide_sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "guide_id": {
                "type": "string",
                "minLength": 1
              },
              "question_id": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/QuestionId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "guide_id",
              "question_id",
              "sentence"
            ],
            "additionalProperties": false
          }
        },
        "fixed_sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/FixedSentenceKey"
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "key",
              "sentence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "question_sentences",
        "refusal_explanations",
        "reask_sentences",
        "choices",
        "guide_sentences",
        "fixed_sentences"
      ],
      "additionalProperties": false
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string"
        },
        "slot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "SourceText": {
      "type": "string",
      "minLength": 1
    },
    "Target": {
      "oneOf": [
        {
          "$ref": "#/$defs/SlotRef"
        },
        {
          "$ref": "#/$defs/WholeQuestion"
        }
      ]
    },
    "TextSpan": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "offset_unit": {
          "type": "string",
          "enum": [
            "unicode_code_point",
            "utf16_code_unit",
            "utf8_byte"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "start",
        "end",
        "offset_unit",
        "text"
      ],
      "additionalProperties": false
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
