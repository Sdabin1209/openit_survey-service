{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/OrchestratorOutput.json",
  "$ref": "#/$defs/OrchestratorOutput",
  "$defs": {
    "AlertKind": {
      "oneOf": [
        {
          "const": "RISK"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "USER_CALLED_STAFF"
        }
      ]
    },
    "CodedValue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "Decision": {
      "oneOf": [
        {
          "const": "RESUME"
        },
        {
          "const": "END"
        }
      ]
    },
    "ExtractionRecord": {
      "type": "object",
      "description": "LoRA-A 출력(boundary-contracts ActionExtraction)의 기록 사본. 형식 검증은 model-runtime과 boundary_contracts가 한다. 여기서는 읽는 쪽이 기대는 필드만 요구하고 모르는 필드는 허용한다.",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {},
              "precision": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "save": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "value",
              "precision",
              "status",
              "save"
            ],
            "additionalProperties": true
          }
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "next_item": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "values",
        "action",
        "next_item"
      ],
      "additionalProperties": true
    },
    "FailedStep": {
      "type": "object",
      "properties": {
        "phase": {
          "oneOf": [
            {
              "const": "BEFORE_COMMIT"
            },
            {
              "const": "AFTER_COMMIT"
            }
          ]
        },
        "step": {
          "oneOf": [
            {
              "const": "LoRA-A"
            },
            {
              "const": "VALIDATE"
            },
            {
              "const": "COMMIT"
            },
            {
              "const": "DELIVER_STAFF"
            },
            {
              "const": "LoRA-B"
            },
            {
              "const": "DELIVER_FRONT"
            }
          ]
        }
      },
      "required": [
        "phase",
        "step"
      ],
      "additionalProperties": false
    },
    "InputKind": {
      "oneOf": [
        {
          "const": "SESSION_START"
        },
        {
          "const": "UTTERANCE"
        },
        {
          "const": "INTERVENTION"
        },
        {
          "const": "SESSION_END"
        }
      ]
    },
    "InterventionResult": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "result": {
          "oneOf": [
            {
              "const": "APPLIED"
            },
            {
              "const": "IGNORED"
            },
            {
              "const": "FAILED"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "result"
      ],
      "additionalProperties": false
    },
    "LogEntry": {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "properties": {
            "kind": {
              "$ref": "#/$defs/InputKind"
            },
            "utterance": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "intervention_decision": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Decision"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "utterance",
            "intervention_decision"
          ],
          "additionalProperties": false
        },
        "handling": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "handled": {
                  "$ref": "#/$defs/TurnKind"
                }
              },
              "required": [
                "handled"
              ],
              "additionalProperties": false
            },
            {
              "const": "IGNORED"
            }
          ]
        },
        "question_bank_version": {
          "type": "integer",
          "minimum": 0
        },
        "turn_result": {
          "oneOf": [
            {
              "const": "COMMITTED"
            },
            {
              "const": "NOT_APPLICABLE"
            },
            {
              "type": "object",
              "properties": {
                "failed_steps": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/FailedStep"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "failed_steps"
              ],
              "additionalProperties": false
            }
          ]
        },
        "extract_output": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractionRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_violations": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ViolationRecord"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "staff_alert": {
          "anyOf": [
            {
              "$ref": "#/$defs/StaffAlert"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "staff_alert_delivery": {
          "oneOf": [
            {
              "const": "SUCCESS"
            },
            {
              "const": "FAILURE"
            },
            {
              "const": "NOT_APPLICABLE"
            }
          ]
        },
        "turn_failure_signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnFailureSignal"
            },
            {
              "type": "null"
            }
          ]
        },
        "intervention_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterventionResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "staff_id": {
          "type": "string",
          "minLength": 1,
          "description": "직원 개입 항목에서 게이트웨이가 인증한 계정 ID(X-Openit-User). 개입이 아닌 항목에는 없다."
        }
      },
      "required": [
        "input",
        "handling",
        "question_bank_version",
        "turn_result",
        "extract_output",
        "validation_violations",
        "staff_alert",
        "response_text",
        "staff_alert_delivery",
        "turn_failure_signal",
        "intervention_result"
      ],
      "additionalProperties": false
    },
    "OrchestratorOutput": {
      "type": "object",
      "properties": {
        "turn_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_info_created": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "log_entry": {
          "anyOf": [
            {
              "$ref": "#/$defs/LogEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_failure_signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnFailureSignal"
            },
            {
              "type": "null"
            }
          ]
        },
        "intervention_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterventionResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "dispatch_called": {
          "type": "boolean"
        }
      },
      "required": [
        "turn_kind",
        "session_info_created",
        "log_entry",
        "turn_failure_signal",
        "intervention_result",
        "dispatch_called"
      ],
      "additionalProperties": false
    },
    "QuestionId": {
      "type": "string",
      "minLength": 1
    },
    "SessionId": {
      "type": "string",
      "minLength": 1
    },
    "SessionInfo": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "question_bank_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "session_id",
        "question_bank_version"
      ],
      "additionalProperties": false
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string"
        },
        "slot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "SourceText": {
      "type": "string",
      "minLength": 1
    },
    "StaffAlert": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AlertKind"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StaffAlertReason"
          }
        }
      },
      "required": [
        "kind",
        "reasons"
      ],
      "additionalProperties": false
    },
    "StaffAlertReason": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_SIGNAL"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_RULE"
            },
            "target": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slot": {
                    "$ref": "#/$defs/SlotRef"
                  },
                  "question_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "$ref": "#/$defs/Value"
                  }
                },
                "required": [
                  "slot",
                  "question_name",
                  "value"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "USER_CALLED_STAFF"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TurnFailureSignal": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "write_committed": {
          "oneOf": [
            {
              "const": "COMMITTED"
            },
            {
              "const": "NOT_COMMITTED"
            }
          ]
        },
        "staff_alert": {
          "oneOf": [
            {
              "const": "NONE"
            },
            {
              "const": "DELIVERED"
            },
            {
              "const": "DELIVERY_FAILED"
            }
          ]
        },
        "pause_reason": {
          "description": "정지 사유(2.1.0, CR-H002). 위험 신호/위험 규칙은 RISK, 되묻기 한도 초과는 REASK_LIMIT, 그 밖은 OTHER. optional: 없으면 미상. 읽는 쪽은 모르는 값을 OTHER로 취급한다.",
          "oneOf": [
            {
              "const": "RISK"
            },
            {
              "const": "REASK_LIMIT"
            },
            {
              "const": "OTHER"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "write_committed",
        "staff_alert"
      ],
      "additionalProperties": false
    },
    "TurnKind": {
      "oneOf": [
        {
          "const": "SESSION_START"
        },
        {
          "const": "UTTERANCE"
        },
        {
          "const": "RESUME"
        },
        {
          "const": "INTERVENTION_END"
        },
        {
          "const": "END_LEFT"
        }
      ]
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "unit_code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/CodedValue"
        }
      ]
    },
    "ViolationRecord": {
      "type": "object",
      "description": "서비스 검사 위반의 기록(값 없음: code, path, message).",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
