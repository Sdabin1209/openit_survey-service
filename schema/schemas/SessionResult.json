{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/SessionResult.json",
  "$ref": "#/$defs/SessionResult",
  "$defs": {
    "SubjectRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/#=+-]{1,128}$",
      "description": "병원이 정한 불투명 환자·방문 참조."
    },
    "SessionStatus": {
      "oneOf": [
        {
          "const": "IN_PROGRESS"
        },
        {
          "const": "PAUSED_RISK"
        },
        {
          "const": "ENDED_COMPLETE"
        },
        {
          "const": "ENDED_STAFF"
        },
        {
          "const": "ENDED_LEFT"
        },
        {
          "const": "ENDED_USER_STOP"
        }
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC ISO 8601, 초 단위, 끝에 Z."
    },
    "SessionResult": {
      "type": "object",
      "description": "GET /v1/results의 한 세션 결과(병원·의사 시스템용 읽기 전용). 끝나지 않았거나 직원·이탈로 끝난 세션의 부분 결과도 status와 함께 나온다. 환자 발화 원문과 대화 로그는 없다.",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "question_bank_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "저장된 값 한 칸(값이 없는 칸은 나오지 않는다). key는 모델 키(Q7_1[soju].amount). status는 ANSWERED, 정정된 적이 있으면 CORRECTION.",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "status": {
                "type": "string",
                "minLength": 1
              },
              "precision": {
                "type": "string",
                "enum": [
                  "exact",
                  "approximate",
                  "unspecified"
                ]
              }
            },
            "required": [
              "key",
              "value",
              "status",
              "precision"
            ],
            "additionalProperties": false
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "session_id",
        "subject_ref",
        "status",
        "started_at",
        "ended_at",
        "release_id",
        "question_bank_version",
        "answers",
        "skipped"
      ],
      "additionalProperties": false
    }
  }
}
