{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/SessionResult.json",
  "$ref": "#/$defs/SessionResult",
  "$defs": {
    "SubjectRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/#=+-]{1,128}$",
      "description": "병원이 정한 불투명 환자·방문 참조."
    },
    "SessionStatus": {
      "oneOf": [
        {
          "const": "IN_PROGRESS"
        },
        {
          "const": "PAUSED_RISK"
        },
        {
          "const": "ENDED_COMPLETE"
        },
        {
          "const": "ENDED_STAFF"
        },
        {
          "const": "ENDED_LEFT"
        },
        {
          "const": "ENDED_USER_STOP"
        }
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC ISO 8601, 초 단위, 끝에 Z."
    },
    "SessionResult": {
      "type": "object",
      "description": "GET /v1/results의 한 세션 결과(병원·의사 시스템용 읽기 전용). 끝나지 않았거나 직원·이탈로 끝난 세션의 부분 결과도 status와 함께 나온다. 환자 발화 원문과 대화 로그는 없다.",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "question_bank_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "저장된 값 한 칸(값이 없는 칸은 나오지 않는다). key는 모델 키(Q7_1[soju].amount). status는 ANSWERED, 정정된 적이 있으면 CORRECTION.",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "status": {
                "type": "string",
                "minLength": 1
              },
              "precision": {
                "type": "string",
                "enum": [
                  "exact",
                  "approximate",
                  "unspecified"
                ]
              }
            },
            "required": [
              "key",
              "value",
              "status",
              "precision"
            ],
            "additionalProperties": false
          }
        },
        "skipped_details": {
          "type": "array",
          "description": "빈칸의 원인(survey-schema 1.3.0에서 추가, 2.0.0에서 문자열 목록 `skipped`를 폐지하고 이 필드만 남았다). 값이 저장되지 않은 칸(slot, 모델 키)과 건너뛴 문항(item)의 원인 코드. UNKNOWN=환자가 모름, REJECTED=거절·나중에, UNCLEAR=불분명하거나 범위 밖이라 끝내 값이 정해지지 않음, REASK_LIMIT=같은 문항을 되묻기 한도(SURVEY_MAX_CONSECUTIVE_REASK)만큼 되물어도 끝내 정해지지 않아 빈칸으로 두고 다음 문항으로 감(같은 정수 버전 1 안의 추가, CONVENTIONS 12절). 환자 발화 원문은 없다(감사 C2).",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1,
                "description": "문항 ID"
              },
              "slot": {
                "type": "string",
                "minLength": 1,
                "description": "칸의 모델 키(answers[].key와 같은 모양). 칸을 알 수 없으면 생략한다."
              },
              "reason": {
                "enum": [
                  "UNKNOWN",
                  "REJECTED",
                  "UNCLEAR",
                  "REASK_LIMIT"
                ]
              }
            },
            "required": [
              "item",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "acknowledged_by": {
          "type": "string",
          "minLength": 1,
          "description": "결과를 확인한 계정 ID(게이트웨이가 인증해 넘긴 X-Openit-User). 확인 전에는 없다. 정수 버전 1 안의 선택 필드 추가(U83)."
        },
        "acknowledged_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "확인한 시각(UTC). 두 번째 확인은 처음 값을 바꾸지 않는다."
        }
      },
      "required": [
        "session_id",
        "subject_ref",
        "status",
        "started_at",
        "ended_at",
        "release_id",
        "question_bank_version",
        "answers",
        "skipped_details"
      ],
      "additionalProperties": false
    }
  }
}
