{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/TurnTrace.json",
  "$ref": "#/$defs/TurnTrace",
  "$defs": {
    "AlertKind": {
      "oneOf": [
        {
          "const": "RISK"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "USER_CALLED_STAFF"
        }
      ]
    },
    "AnswerUpdate": {
      "type": "object",
      "description": "저장할 값 하나. FIRST_WRITE는 첫 저장, NEW_REVISION은 이전 값을 이력에 쌓고 바꾼다(정정).",
      "properties": {
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "action": {
          "enum": [
            "FIRST_WRITE",
            "NEW_REVISION"
          ]
        },
        "value": {
          "$ref": "#/$defs/Value"
        },
        "precision": {
          "$ref": "#/$defs/Precision"
        }
      },
      "required": [
        "slot",
        "action",
        "value",
        "precision"
      ],
      "additionalProperties": false
    },
    "CodedValue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "CurrentValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "answer": {
              "$ref": "#/$defs/Value"
            }
          },
          "required": [
            "answer"
          ],
          "additionalProperties": false
        },
        {
          "const": "NONE"
        }
      ]
    },
    "Decision": {
      "oneOf": [
        {
          "const": "RESUME"
        },
        {
          "const": "END"
        }
      ]
    },
    "DispatchInput": {
      "type": "object",
      "properties": {
        "session_info": {
          "$ref": "#/$defs/SessionInfo"
        },
        "answer_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRecord"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkipEntry"
          }
        },
        "session_status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "pause_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseEntry"
          }
        }
      },
      "required": [
        "session_info",
        "answer_records",
        "skipped",
        "session_status",
        "pause_history"
      ],
      "additionalProperties": false
    },
    "DispatchOutput": {
      "type": "object",
      "properties": {
        "dispatch_record": {
          "$ref": "#/$defs/DispatchRecord"
        }
      },
      "required": [
        "dispatch_record"
      ],
      "additionalProperties": false
    },
    "DispatchRecord": {
      "type": "object",
      "properties": {
        "succeeded": {
          "type": "boolean"
        }
      },
      "required": [
        "succeeded"
      ],
      "additionalProperties": false
    },
    "ExtractionInputRecord": {
      "type": "object",
      "description": "LoRA-A 입력(ActionExtractionInput)의 기록 사본.",
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "current_question": {
          "type": "string"
        },
        "user_utterance": {
          "type": "string"
        },
        "state": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "question_id",
        "current_question",
        "user_utterance",
        "state"
      ],
      "additionalProperties": true
    },
    "ExtractionRecord": {
      "type": "object",
      "description": "LoRA-A 출력(boundary-contracts ActionExtraction)의 기록 사본. 형식 검증은 model-runtime과 boundary_contracts가 한다. 여기서는 읽는 쪽이 기대는 필드만 요구하고 모르는 필드는 허용한다.",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {},
              "precision": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "save": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "value",
              "precision",
              "status",
              "save"
            ],
            "additionalProperties": true
          }
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "next_item": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "values",
        "action",
        "next_item"
      ],
      "additionalProperties": true
    },
    "FailedStep": {
      "type": "object",
      "properties": {
        "phase": {
          "oneOf": [
            {
              "const": "BEFORE_COMMIT"
            },
            {
              "const": "AFTER_COMMIT"
            }
          ]
        },
        "step": {
          "oneOf": [
            {
              "const": "LoRA-A"
            },
            {
              "const": "VALIDATE"
            },
            {
              "const": "COMMIT"
            },
            {
              "const": "DELIVER_STAFF"
            },
            {
              "const": "LoRA-B"
            },
            {
              "const": "DELIVER_FRONT"
            }
          ]
        }
      },
      "required": [
        "phase",
        "step"
      ],
      "additionalProperties": false
    },
    "FrontendInput": {
      "type": "object",
      "properties": {
        "response_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_failure_signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnFailureSignal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "response_text",
        "turn_failure_signal"
      ],
      "additionalProperties": false
    },
    "FrontendMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "kind": {
              "const": "SESSION_START"
            }
          },
          "required": [
            "session_id",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "kind": {
              "const": "UTTERANCE"
            },
            "utterance": {
              "type": "string"
            }
          },
          "required": [
            "session_id",
            "kind",
            "utterance"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "kind": {
              "const": "SESSION_END"
            }
          },
          "required": [
            "session_id",
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "HistoryEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/Value"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/Value"
            },
            "precision": {
              "$ref": "#/$defs/Precision"
            }
          },
          "required": [
            "value",
            "precision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "InputKind": {
      "oneOf": [
        {
          "const": "SESSION_START"
        },
        {
          "const": "UTTERANCE"
        },
        {
          "const": "INTERVENTION"
        },
        {
          "const": "SESSION_END"
        }
      ]
    },
    "InterventionDecision": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        }
      },
      "required": [
        "session_id",
        "decision"
      ],
      "additionalProperties": false
    },
    "InterventionResult": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "result": {
          "oneOf": [
            {
              "const": "APPLIED"
            },
            {
              "const": "IGNORED"
            },
            {
              "const": "FAILED"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "result"
      ],
      "additionalProperties": false
    },
    "LogEntry": {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "properties": {
            "kind": {
              "$ref": "#/$defs/InputKind"
            },
            "utterance": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "intervention_decision": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Decision"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "utterance",
            "intervention_decision"
          ],
          "additionalProperties": false
        },
        "handling": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "handled": {
                  "$ref": "#/$defs/TurnKind"
                }
              },
              "required": [
                "handled"
              ],
              "additionalProperties": false
            },
            {
              "const": "IGNORED"
            }
          ]
        },
        "question_bank_version": {
          "type": "integer",
          "minimum": 0
        },
        "turn_result": {
          "oneOf": [
            {
              "const": "COMMITTED"
            },
            {
              "const": "NOT_APPLICABLE"
            },
            {
              "type": "object",
              "properties": {
                "failed_steps": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/FailedStep"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "failed_steps"
              ],
              "additionalProperties": false
            }
          ]
        },
        "extract_output": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractionRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_violations": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ViolationRecord"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "staff_alert": {
          "anyOf": [
            {
              "$ref": "#/$defs/StaffAlert"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "staff_alert_delivery": {
          "oneOf": [
            {
              "const": "SUCCESS"
            },
            {
              "const": "FAILURE"
            },
            {
              "const": "NOT_APPLICABLE"
            }
          ]
        },
        "turn_failure_signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnFailureSignal"
            },
            {
              "type": "null"
            }
          ]
        },
        "intervention_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterventionResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "staff_id": {
          "type": "string",
          "minLength": 1,
          "description": "직원 개입 항목에서 게이트웨이가 인증한 계정 ID(X-Openit-User). 개입이 아닌 항목에는 없다."
        }
      },
      "required": [
        "input",
        "handling",
        "question_bank_version",
        "turn_result",
        "extract_output",
        "validation_violations",
        "staff_alert",
        "response_text",
        "staff_alert_delivery",
        "turn_failure_signal",
        "intervention_result"
      ],
      "additionalProperties": false
    },
    "OpenSlot": {
      "type": "object",
      "description": "저장하지 않은 칸 중 직전 추출이 MISSING·UNCLEAR로 본 것. A 입력의 state에 싣는다. 문항이 바뀌면 비운다.",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "MISSING",
            "UNCLEAR"
          ]
        }
      },
      "required": [
        "key",
        "status"
      ],
      "additionalProperties": false
    },
    "OrchestratorInput": {
      "type": "object",
      "properties": {
        "frontend_input": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrontendMessage"
            },
            {
              "type": "null"
            }
          ]
        },
        "intervention_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterventionDecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_found": {
          "type": "boolean"
        },
        "session_question_bank_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "session_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_question_bank_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "frontend_input",
        "intervention_decision",
        "session_found",
        "session_question_bank_version",
        "session_status",
        "latest_question_bank_version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "frontend_input": {
                  "not": {
                    "enum": [
                      null
                    ]
                  }
                },
                "intervention_decision": {
                  "enum": [
                    null
                  ]
                }
              }
            },
            {
              "properties": {
                "frontend_input": {
                  "enum": [
                    null
                  ]
                },
                "intervention_decision": {
                  "not": {
                    "enum": [
                      null
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "session_found": {
                "enum": [
                  false
                ]
              }
            }
          },
          "then": {
            "properties": {
              "session_status": {
                "enum": [
                  null
                ]
              },
              "session_question_bank_version": {
                "enum": [
                  null
                ]
              }
            }
          },
          "else": {
            "properties": {
              "session_status": {
                "not": {
                  "enum": [
                    null
                  ]
                }
              },
              "session_question_bank_version": {
                "not": {
                  "enum": [
                    null
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "OrchestratorOutput": {
      "type": "object",
      "properties": {
        "turn_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_info_created": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "log_entry": {
          "anyOf": [
            {
              "$ref": "#/$defs/LogEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_failure_signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnFailureSignal"
            },
            {
              "type": "null"
            }
          ]
        },
        "intervention_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterventionResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "dispatch_called": {
          "type": "boolean"
        }
      },
      "required": [
        "turn_kind",
        "session_info_created",
        "log_entry",
        "turn_failure_signal",
        "intervention_result",
        "dispatch_called"
      ],
      "additionalProperties": false
    },
    "PauseEntry": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PauseKind"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseReason"
          }
        }
      },
      "required": [
        "kind",
        "reasons"
      ],
      "additionalProperties": false
    },
    "PauseKind": {
      "oneOf": [
        {
          "const": "PAUSE"
        },
        {
          "const": "RESUME"
        }
      ]
    },
    "PauseReason": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_SIGNAL"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_RULE"
            },
            "target": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SlotRef"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Precision": {
      "type": "string",
      "enum": [
        "exact",
        "approximate",
        "unspecified"
      ]
    },
    "ProgressRecord": {
      "type": "object",
      "description": "current_question_id는 다음 발화를 해석할 문항(A 입력의 question_id)이다. 문진이 끝나면 END.",
      "properties": {
        "current_question_id": {
          "type": "string",
          "minLength": 1
        },
        "open_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenSlot"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkipEntry"
          }
        },
        "session_status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "pause_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseEntry"
          }
        }
      },
      "required": [
        "current_question_id",
        "open_slots",
        "skipped",
        "session_status",
        "pause_history"
      ],
      "additionalProperties": false
    },
    "ProgressRecordUpdate": {
      "type": "object",
      "properties": {
        "current_question_id": {
          "type": "string",
          "minLength": 1
        },
        "open_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenSlot"
          }
        },
        "skipped_add": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkipEntry"
          }
        },
        "skipped_remove": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionId"
          },
          "uniqueItems": true
        },
        "session_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "pause_history_add": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseEntry"
          }
        }
      },
      "required": [
        "current_question_id",
        "open_slots",
        "skipped_add",
        "skipped_remove",
        "session_status",
        "pause_history_add"
      ],
      "additionalProperties": false
    },
    "Protections": {
      "type": "object",
      "description": "X-Openit-Protections를 푼 것: 규칙 코드별 건수.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "QuestionId": {
      "type": "string",
      "minLength": 1
    },
    "ResponseRequestRecord": {
      "type": "object",
      "description": "LoRA-B 입력(ResponseRequest)의 기록 사본.",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string"
        },
        "next": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "action",
        "topic",
        "next"
      ],
      "additionalProperties": true
    },
    "RevisionToken": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "RiskResponse": {
      "oneOf": [
        {
          "const": "IMMEDIATE"
        },
        {
          "const": "ON_RESULT"
        }
      ]
    },
    "SessionCommitRequest": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "expected_revision": {
          "$ref": "#/$defs/RevisionToken"
        },
        "writes": {
          "$ref": "#/$defs/TurnWriteSet"
        }
      },
      "required": [
        "session_id",
        "expected_revision",
        "writes"
      ],
      "additionalProperties": false
    },
    "SessionCommitResult": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "status": {
          "type": "string",
          "enum": [
            "OK",
            "REVISION_CONFLICT",
            "DB_ERROR"
          ]
        },
        "write_outcome": {
          "type": "string",
          "enum": [
            "APPLIED",
            "NOT_APPLIED",
            "UNKNOWN"
          ]
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionToken"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "status",
        "write_outcome",
        "revision",
        "detail"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "OK"
              }
            }
          },
          "then": {
            "properties": {
              "write_outcome": {
                "const": "APPLIED"
              },
              "revision": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "REVISION_CONFLICT"
              }
            }
          },
          "then": {
            "properties": {
              "write_outcome": {
                "const": "NOT_APPLIED"
              },
              "revision": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "DB_ERROR"
              }
            }
          },
          "then": {
            "properties": {
              "write_outcome": {
                "enum": [
                  "NOT_APPLIED",
                  "UNKNOWN"
                ]
              }
            }
          }
        }
      ]
    },
