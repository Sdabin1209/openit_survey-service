{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/NormalizerOutput.json",
  "$ref": "#/$defs/NormalizerOutput",
  "$defs": {
    "CodedValue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "offset_unit": {
          "type": "string",
          "enum": [
            "unicode_code_point",
            "utf16_code_unit",
            "utf8_byte"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "turn_index",
        "start",
        "end",
        "offset_unit",
        "text"
      ],
      "additionalProperties": false
    },
    "ItemCheck": {
      "type": "object",
      "properties": {
        "item_no": {
          "type": "integer",
          "minimum": 0
        },
        "standard_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Problem"
          },
          "uniqueItems": true
        },
        "mismatched_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          }
        },
        "vs_current": {
          "oneOf": [
            {
              "const": "EQUAL"
            },
            {
              "const": "DIFFERENT"
            },
            {
              "const": "NO_CURRENT"
            },
            {
              "const": "NOT_APPLICABLE"
            }
          ]
        },
        "vs_pending": {
          "oneOf": [
            {
              "const": "EQUAL"
            },
            {
              "const": "DIFFERENT"
            },
            {
              "const": "NO_PENDING"
            },
            {
              "const": "NOT_APPLICABLE"
            }
          ]
        },
        "risk_rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "prerequisite_unmet": {
          "type": "boolean"
        },
        "value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        },
        "problem_details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProblemDetail"
          }
        }
      },
      "required": [
        "item_no",
        "standard_value",
        "problems",
        "mismatched_slots",
        "vs_current",
        "vs_pending",
        "risk_rule",
        "prerequisite_unmet"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "value_metadata"
            ],
            "properties": {
              "value_metadata": {
                "properties": {
                  "precision": {
                    "enum": [
                      "exact",
                      "approximate"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "standard_value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "NormalizerOutput": {
      "type": "object",
      "properties": {
        "item_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemCheck"
          }
        },
        "missing_required_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          }
        }
      },
      "required": [
        "item_checks",
        "missing_required_slots"
      ],
      "additionalProperties": false
    },
    "Precision": {
      "type": "string",
      "enum": [
        "exact",
        "approximate",
        "unspecified"
      ]
    },
    "Problem": {
      "oneOf": [
        {
          "const": "NO_UNIT"
        },
        {
          "const": "OUT_OF_RANGE"
        },
        {
          "const": "AMBIGUOUS"
        },
        {
          "const": "MISMATCH"
        },
        {
          "const": "UNKNOWN_TARGET"
        }
      ]
    },
    "ProblemDetail": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/Problem"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          }
        },
        "message": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "category",
        "code",
        "refs",
        "message"
      ],
      "additionalProperties": false
    },
    "QuestionId": {
      "type": "string",
      "minLength": 1
    },
    "RiskResponse": {
      "oneOf": [
        {
          "const": "IMMEDIATE"
        },
        {
          "const": "ON_RESULT"
        }
      ]
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string"
        },
        "slot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "unit_code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/CodedValue"
        }
      ]
    },
    "ValueMetadata": {
      "type": "object",
      "properties": {
        "precision": {
          "$ref": "#/$defs/Precision"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      },
      "required": [
        "precision",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
