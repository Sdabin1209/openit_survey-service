{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/QuestionBank.json",
  "$ref": "#/$defs/QuestionBank",
  "$defs": {
    "ChoiceDef": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "code",
        "label",
        "synonyms"
      ],
      "additionalProperties": false
    },
    "CodedValue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "FillValue": {
      "oneOf": [
        {
          "const": "REMAINING_COUNT"
        }
      ]
    },
    "FixedSentence": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/FixedSentenceKey"
        },
        "sentence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "sentence"
      ],
      "additionalProperties": false
    },
    "FixedSentenceKey": {
      "oneOf": [
        {
          "const": "ASK_REPEAT"
        },
        {
          "const": "OOS_NOTICE"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "FAREWELL"
        },
        {
          "const": "ASK_CONFIRM"
        },
        {
          "const": "ASK_CORRECTION_TARGET"
        },
        {
          "const": "ASK_FINISH"
        },
        {
          "const": "RISK_NOTICE"
        },
        {
          "const": "RESUME"
        },
        {
          "const": "SURVEY_STOPPED"
        },
        {
          "const": "WAIT_NOTICE"
        },
        {
          "const": "ASK_STOP"
        },
        {
          "const": "STAFF_NOTICE"
        },
        {
          "const": "DEFERRED"
        }
      ]
    },
    "GuideItem": {
      "type": "object",
      "properties": {
        "guide_id": {
          "type": "string",
          "minLength": 1
        },
        "selection_criterion": {
          "type": "string",
          "minLength": 1
        },
        "per_question": {
          "type": "boolean"
        },
        "sentence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "fill_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/FillValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "guide_id",
        "selection_criterion",
        "per_question",
        "sentence",
        "fill_value"
      ],
      "additionalProperties": false
    },
    "Policy": {
      "type": "object",
      "properties": {
        "question_limit": {
          "type": "integer",
          "minimum": 1
        },
        "unknown_accept_after": {
          "type": "integer",
          "minimum": 1
        },
        "refusal_accept_after": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "question_limit",
        "unknown_accept_after",
        "refusal_accept_after"
      ],
      "additionalProperties": false
    },
    "Prerequisite": {
      "type": "object",
      "properties": {
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "slot",
        "value"
      ],
      "additionalProperties": false
    },
    "QuestionBank": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionDef"
          },
          "minItems": 1
        },
        "session_settings": {
          "$ref": "#/$defs/SessionSettings"
        }
      },
      "required": [
        "version",
        "questions",
        "session_settings"
      ],
      "additionalProperties": false
    },
    "QuestionDef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "prerequisite": {
          "anyOf": [
            {
              "$ref": "#/$defs/Prerequisite"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_sentence": {
          "type": "string",
          "minLength": 1
        },
        "refusal_explanation": {
          "type": "string",
          "minLength": 1
        },
        "guide_sentences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionGuideSentence"
          }
        },
        "affected_followups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionId"
          },
          "uniqueItems": true
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "repeat_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotDef"
          },
          "minItems": 1
        }
      },
      "required": [
        "question_id",
        "name",
        "order",
        "prerequisite",
        "question_sentence",
        "refusal_explanation",
        "guide_sentences",
        "affected_followups",
        "policy",
        "repeat_keys",
        "slots"
      ],
      "additionalProperties": false
    },
    "QuestionGuideSentence": {
      "type": "object",
      "properties": {
        "guide_id": {
          "type": "string",
          "minLength": 1
        },
        "sentence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "guide_id",
        "sentence"
      ],
      "additionalProperties": false
    },
    "QuestionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.]+$",
      "description": "문항 ID. 계약 QuestionFieldSpec.slot(`문항.칸`)의 앞부분 패턴과 같다(영문·숫자·밑줄·점)."
    },
    "RiskResponse": {
      "oneOf": [
        {
          "const": "IMMEDIATE"
        },
        {
          "const": "ON_RESULT"
        }
      ]
    },
    "RiskRule": {
      "type": "object",
      "properties": {
        "operator": {
          "oneOf": [
            {
              "const": "="
            },
            {
              "const": ">="
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/Value"
        },
        "response": {
          "$ref": "#/$defs/RiskResponse"
        }
      },
      "required": [
        "operator",
        "value",
        "response"
      ],
      "additionalProperties": false
    },
    "SessionSettings": {
      "type": "object",
      "properties": {
        "risk_phrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confirm_limit": {
          "type": "integer",
          "minimum": 1
        },
        "unrecognized_streak_limit": {
          "type": "integer",
          "minimum": 1
        },
        "ask_limit": {
          "type": "integer",
          "minimum": 1
        },
        "fixed_sentences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixedSentence"
          },
          "description": "고정 문장. 적재 거부 조건: RISK_NOTICE, CALL_STAFF, RESUME, SURVEY_STOPPED 네 개는 공백이 아닌 문장으로 반드시 있어야 한다(위험 정지 안내·직원 호출·재개·종료 안내가 비면 환자 화면이 빈다).",
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "RISK_NOTICE"
                  },
                  "sentence": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "key",
                  "sentence"
                ]
              },
              "description": "필수 고정 문장 RISK_NOTICE이(가) 없거나 비어 있다"
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "CALL_STAFF"
                  },
                  "sentence": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "key",
                  "sentence"
                ]
              },
              "description": "필수 고정 문장 CALL_STAFF이(가) 없거나 비어 있다"
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "RESUME"
                  },
                  "sentence": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "key",
                  "sentence"
                ]
              },
              "description": "필수 고정 문장 RESUME이(가) 없거나 비어 있다"
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "SURVEY_STOPPED"
                  },
                  "sentence": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "key",
                  "sentence"
                ]
              },
              "description": "필수 고정 문장 SURVEY_STOPPED이(가) 없거나 비어 있다"
            }
          ]
        },
        "guide_list": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuideItem"
          }
        }
      },
      "required": [
        "risk_phrases",
        "confirm_limit",
        "unrecognized_streak_limit",
        "ask_limit",
        "fixed_sentences",
        "guide_list"
      ],
      "additionalProperties": false
    },
    "SlotDef": {
      "type": "object",
      "properties": {
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$",
          "description": "칸 ID. 계약 QuestionFieldSpec.slot(`문항.칸`)의 칸 부분 패턴과 같다(영문·숫자·밑줄, 점 없음)."
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnitDef"
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "option 칸의 선택지 코드. choice_catalog를 쓰면 비워야 한다."
        },
        "yes_no_map": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "yes": {
                  "type": "string",
                  "minLength": 1
                },
                "no": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "yes",
                "no"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "reask_sentence": {
          "type": "string",
          "minLength": 1
        },
        "risk_rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "choice_catalog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChoiceDef"
          },
          "minItems": 1,
          "description": "option 칸의 선택지(코드·표시·동의어). 쓰면 choices는 비워야 하고 선택지 코드는 각 code다. 적재 거부 조건(스키마로 표현하지 못함): code가 겹치면 적재가 INVALID_FIELD_SPEC으로 거부한다."
        },
        "data_type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "option"
          ],
          "description": "칸 자료형(survey-schema 3.0.0부터 필수). 계약 QuestionFieldSpec의 data_type과 같다. 값은 학습 데이터셋 question_fields와 같아야 한다. option이면 선택지 코드는 choices 또는 choice_catalog의 code다(둘 중 하나는 비어 있지 않아야 한다). 자료형이 없는 칸은 서버가 값 규칙을 보증하지 못해 적재가 거부된다."
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "description": "칸 값의 단위 이름(데이터셋 question_fields.unit: 개비, 년, minute, day/week). `units`(UnitDef 목록, 사용자 말의 단위 환산)와 다르다."
        },
        "minimum": {
          "type": "number",
          "description": "값의 최솟값(포함)."
        },
        "maximum": {
          "type": "number",
          "description": "값의 최댓값(포함)."
        },
        "exclusive_minimum": {
          "type": "number",
          "description": "값은 이 수보다 커야 한다(예: 횟수는 0 초과)."
        }
      },
      "required": [
        "slot_id",
        "units",
        "choices",
        "yes_no_map",
        "required",
        "reask_sentence",
        "risk_rule",
        "data_type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "choice_catalog"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data_type": {
                "const": "option"
              }
            },
            "required": [
              "data_type"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "choices": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "choice_catalog"
                ]
              }
            ]
          },
          "description": "option 칸에는 선택지(choices 또는 choice_catalog)가 있어야 한다. 선택지를 모르면 서버가 선택지 값을 막을 수 없어 적재가 거부된다."
        }
      ]
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string"
        },
        "slot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "UnitDef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "range": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "convert_to": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "factor": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit_code": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "unit",
                "factor"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "synonyms",
        "range",
        "convert_to"
      ],
      "additionalProperties": false
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "unit_code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/CodedValue"
        }
      ]
    }
  }
}
