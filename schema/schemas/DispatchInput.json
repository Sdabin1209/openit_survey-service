{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/DispatchInput.json",
  "$ref": "#/$defs/DispatchInput",
  "$defs": {
    "CodedValue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "CurrentValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "answer": {
              "$ref": "#/$defs/Value"
            }
          },
          "required": [
            "answer"
          ],
          "additionalProperties": false
        },
        {
          "const": "NONE"
        }
      ]
    },
    "DispatchInput": {
      "type": "object",
      "properties": {
        "session_info": {
          "$ref": "#/$defs/SessionInfo"
        },
        "answer_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRecord"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkipEntry"
          }
        },
        "session_status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "pause_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseEntry"
          }
        }
      },
      "required": [
        "session_info",
        "answer_records",
        "skipped",
        "session_status",
        "pause_history"
      ],
      "additionalProperties": false
    },
    "HistoryEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/Value"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/Value"
            },
            "precision": {
              "$ref": "#/$defs/Precision"
            }
          },
          "required": [
            "value",
            "precision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PauseEntry": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PauseKind"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseReason"
          }
        }
      },
      "required": [
        "kind",
        "reasons"
      ],
      "additionalProperties": false
    },
    "PauseKind": {
      "oneOf": [
        {
          "const": "PAUSE"
        },
        {
          "const": "RESUME"
        }
      ]
    },
    "PauseReason": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_SIGNAL"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_RULE"
            },
            "target": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SlotRef"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Precision": {
      "type": "string",
      "enum": [
        "exact",
        "approximate",
        "unspecified"
      ]
    },
    "QuestionId": {
      "type": "string",
      "minLength": 1
    },
    "RiskResponse": {
      "oneOf": [
        {
          "const": "IMMEDIATE"
        },
        {
          "const": "ON_RESULT"
        }
      ]
    },
    "SessionId": {
      "type": "string",
      "minLength": 1
    },
    "SessionInfo": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "question_bank_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "session_id",
        "question_bank_version"
      ],
      "additionalProperties": false
    },
    "SessionStatus": {
      "oneOf": [
        {
          "const": "IN_PROGRESS"
        },
        {
          "const": "PAUSED_RISK"
        },
        {
          "const": "ENDED_COMPLETE"
        },
        {
          "const": "ENDED_STAFF"
        },
        {
          "const": "ENDED_LEFT"
        },
        {
          "const": "ENDED_USER_STOP"
        }
      ]
    },
    "SkipEntry": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "reason": {
          "$ref": "#/$defs/SkipReason"
        }
      },
      "required": [
        "question_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "SkipReason": {
      "oneOf": [
        {
          "const": "REQUEST_SKIP"
        },
        {
          "const": "REFUSED"
        },
        {
          "const": "UNCERTAIN"
        }
      ]
    },
    "SlotRecord": {
      "type": "object",
      "description": "칸 하나의 저장 기록. 모델 키 Q7_1[soju].amount는 {question_id Q7_1, repeat_key soju, slot_id amount}다. risk_mark는 위험 입력원이 정해질 때까지 항상 null이다(미정).",
      "properties": {
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "current_value": {
          "$ref": "#/$defs/CurrentValue"
        },
        "precision": {
          "$ref": "#/$defs/Precision"
        },
        "risk_mark": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryEntry"
          }
        }
      },
      "required": [
        "slot",
        "current_value",
        "risk_mark",
        "history"
      ],
      "additionalProperties": false
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string"
        },
        "slot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "SourceText": {
      "type": "string",
      "minLength": 1
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "unit_code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/CodedValue"
        }
      ]
    }
  }
}
