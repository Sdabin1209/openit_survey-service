{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/SessionStore.json",
  "$ref": "#/$defs/SessionStore",
  "$defs": {
    "AlertKind": {
      "oneOf": [
        {
          "const": "RISK"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "USER_CALLED_STAFF"
        }
      ]
    },
    "CodedValue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "CurrentValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "answer": {
              "$ref": "#/$defs/Value"
            }
          },
          "required": [
            "answer"
          ],
          "additionalProperties": false
        },
        {
          "const": "NONE"
        }
      ]
    },
    "Decision": {
      "oneOf": [
        {
          "const": "RESUME"
        },
        {
          "const": "END"
        }
      ]
    },
    "DispatchRecord": {
      "type": "object",
      "properties": {
        "succeeded": {
          "type": "boolean"
        }
      },
      "required": [
        "succeeded"
      ],
      "additionalProperties": false
    },
    "ExtractionRecord": {
      "type": "object",
      "description": "LoRA-A 출력(boundary-contracts ActionExtraction)의 기록 사본. 형식 검증은 model-runtime과 boundary_contracts가 한다. 여기서는 읽는 쪽이 기대는 필드만 요구하고 모르는 필드는 허용한다.",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {},
              "precision": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "save": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "value",
              "precision",
              "status",
              "save"
            ],
            "additionalProperties": true
          }
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "next_item": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "values",
        "action",
        "next_item"
      ],
      "additionalProperties": true
    },
    "FailedStep": {
      "type": "object",
      "properties": {
        "phase": {
          "oneOf": [
            {
              "const": "BEFORE_COMMIT"
            },
            {
              "const": "AFTER_COMMIT"
            }
          ]
        },
        "step": {
          "oneOf": [
            {
              "const": "LoRA-A"
            },
            {
              "const": "VALIDATE"
            },
            {
              "const": "COMMIT"
            },
            {
              "const": "DELIVER_STAFF"
            },
            {
              "const": "LoRA-B"
            },
            {
              "const": "DELIVER_FRONT"
            }
          ]
        }
      },
      "required": [
        "phase",
        "step"
      ],
      "additionalProperties": false
    },
    "HistoryEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/Value"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/Value"
            },
            "precision": {
              "$ref": "#/$defs/Precision"
            }
          },
          "required": [
            "value",
            "precision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "InputKind": {
      "oneOf": [
        {
          "const": "SESSION_START"
        },
        {
          "const": "UTTERANCE"
        },
        {
          "const": "INTERVENTION"
        },
        {
          "const": "SESSION_END"
        }
      ]
    },
    "InterventionResult": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "result": {
          "oneOf": [
            {
              "const": "APPLIED"
            },
            {
              "const": "IGNORED"
            },
            {
              "const": "FAILED"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "result"
      ],
      "additionalProperties": false
    },
    "LogEntry": {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "properties": {
            "kind": {
              "$ref": "#/$defs/InputKind"
            },
            "utterance": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "intervention_decision": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Decision"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "utterance",
            "intervention_decision"
          ],
          "additionalProperties": false
        },
        "handling": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "handled": {
                  "$ref": "#/$defs/TurnKind"
                }
              },
              "required": [
                "handled"
              ],
              "additionalProperties": false
            },
            {
              "const": "IGNORED"
            }
          ]
        },
        "question_bank_version": {
          "type": "integer",
          "minimum": 0
        },
        "turn_result": {
          "oneOf": [
            {
              "const": "COMMITTED"
            },
            {
              "const": "NOT_APPLICABLE"
            },
            {
              "type": "object",
              "properties": {
                "failed_steps": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/FailedStep"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "failed_steps"
              ],
              "additionalProperties": false
            }
          ]
        },
        "extract_output": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractionRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_violations": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ViolationRecord"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "staff_alert": {
          "anyOf": [
            {
              "$ref": "#/$defs/StaffAlert"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "staff_alert_delivery": {
          "oneOf": [
            {
              "const": "SUCCESS"
            },
            {
              "const": "FAILURE"
            },
            {
              "const": "NOT_APPLICABLE"
            }
          ]
        },
        "turn_failure_signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnFailureSignal"
            },
            {
              "type": "null"
            }
          ]
        },
        "intervention_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterventionResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "staff_id": {
          "type": "string",
          "minLength": 1,
          "description": "직원 개입 항목에서 게이트웨이가 인증한 계정 ID(X-Openit-User). 개입이 아닌 항목에는 없다."
        }
      },
      "required": [
        "input",
        "handling",
        "question_bank_version",
        "turn_result",
        "extract_output",
        "validation_violations",
        "staff_alert",
        "response_text",
        "staff_alert_delivery",
        "turn_failure_signal",
        "intervention_result"
      ],
      "additionalProperties": false
    },
    "OpenSlot": {
      "type": "object",
      "description": "저장하지 않은 칸 중 직전 추출이 MISSING·UNCLEAR로 본 것. A 입력의 state에 싣는다. 문항이 바뀌면 비운다.",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "MISSING",
            "UNCLEAR"
          ]
        }
      },
      "required": [
        "key",
        "status"
      ],
      "additionalProperties": false
    },
    "PauseEntry": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PauseKind"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseReason"
          }
        }
      },
      "required": [
        "kind",
        "reasons"
      ],
      "additionalProperties": false
    },
    "PauseKind": {
      "oneOf": [
        {
          "const": "PAUSE"
        },
        {
          "const": "RESUME"
        }
      ]
    },
    "PauseReason": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_SIGNAL"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_RULE"
            },
            "target": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SlotRef"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Precision": {
      "type": "string",
      "enum": [
        "exact",
        "approximate",
        "unspecified"
      ]
    },
    "ProgressRecord": {
      "type": "object",
      "description": "current_question_id는 다음 발화를 해석할 문항(A 입력의 question_id)이다. 문진이 끝나면 END.",
      "properties": {
        "current_question_id": {
          "type": "string",
          "minLength": 1
        },
        "open_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenSlot"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkipEntry"
          }
        },
        "session_status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "pause_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseEntry"
          }
        }
      },
      "required": [
        "current_question_id",
        "open_slots",
        "skipped",
        "session_status",
        "pause_history"
      ],
      "additionalProperties": false
    },
    "QuestionId": {
      "type": "string",
      "minLength": 1
    },
    "RevisionToken": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "RiskResponse": {
      "oneOf": [
        {
          "const": "IMMEDIATE"
        },
        {
          "const": "ON_RESULT"
        }
      ]
    },
    "SessionId": {
      "type": "string",
      "minLength": 1
    },
    "SessionInfo": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "question_bank_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "session_id",
        "question_bank_version"
      ],
      "additionalProperties": false
    },
    "SessionStatus": {
      "oneOf": [
        {
          "const": "IN_PROGRESS"
        },
        {
          "const": "PAUSED_RISK"
        },
        {
          "const": "ENDED_COMPLETE"
        },
        {
          "const": "ENDED_STAFF"
        },
        {
          "const": "ENDED_LEFT"
        },
        {
          "const": "ENDED_USER_STOP"
        }
      ]
    },
    "SessionStore": {
      "type": "object",
      "properties": {
        "session_info": {
          "$ref": "#/$defs/SessionInfo"
        },
        "answer_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRecord"
          }
        },
        "progress_record": {
          "$ref": "#/$defs/ProgressRecord"
        },
        "dialogue_log": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogEntry"
          }
        },
        "dispatch_log": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DispatchRecord"
          }
        },
        "revision": {
          "$ref": "#/$defs/RevisionToken"
        }
      },
      "required": [
        "session_info",
        "answer_records",
        "progress_record",
        "dialogue_log",
        "dispatch_log"
      ],
      "additionalProperties": false
    },
    "SkipEntry": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "reason": {
          "$ref": "#/$defs/SkipReason"
        }
      },
      "required": [
        "question_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "SkipReason": {
      "oneOf": [
        {
          "const": "REQUEST_SKIP"
        },
        {
          "const": "REFUSED"
        },
        {
          "const": "UNCERTAIN"
        }
      ]
    },
    "SlotRecord": {
      "type": "object",
      "description": "칸 하나의 저장 기록. 모델 키 Q7_1[soju].amount는 {question_id Q7_1, repeat_key soju, slot_id amount}다. risk_mark는 위험 입력원이 정해질 때까지 항상 null이다(미정).",
      "properties": {
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "current_value": {
          "$ref": "#/$defs/CurrentValue"
        },
        "precision": {
          "$ref": "#/$defs/Precision"
        },
        "risk_mark": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryEntry"
          }
        }
      },
      "required": [
        "slot",
        "current_value",
        "risk_mark",
        "history"
      ],
      "additionalProperties": false
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string"
        },
        "slot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "SourceText": {
      "type": "string",
      "minLength": 1
    },
    "StaffAlert": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AlertKind"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StaffAlertReason"
          }
        }
      },
      "required": [
        "kind",
        "reasons"
      ],
      "additionalProperties": false
    },
    "StaffAlertReason": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_SIGNAL"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_RULE"
            },
            "target": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slot": {
                    "$ref": "#/$defs/SlotRef"
                  },
                  "question_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "$ref": "#/$defs/Value"
                  }
                },
                "required": [
                  "slot",
                  "question_name",
                  "value"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "USER_CALLED_STAFF"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TurnFailureSignal": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "write_committed": {
          "oneOf": [
            {
              "const": "COMMITTED"
            },
            {
              "const": "NOT_COMMITTED"
            }
          ]
        },
        "staff_alert": {
          "oneOf": [
            {
              "const": "NONE"
            },
            {
              "const": "DELIVERED"
            },
            {
              "const": "DELIVERY_FAILED"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "write_committed",
        "staff_alert"
      ],
      "additionalProperties": false
    },
    "TurnKind": {
      "oneOf": [
        {
          "const": "SESSION_START"
        },
        {
          "const": "UTTERANCE"
        },
        {
          "const": "RESUME"
        },
        {
          "const": "INTERVENTION_END"
        },
        {
          "const": "END_LEFT"
        }
      ]
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "unit_code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/CodedValue"
        }
      ]
    },
    "ViolationRecord": {
      "type": "object",
      "description": "turn_engine.Violation의 기록(값 없음: code, path, message).",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
