{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/InterventionDecision.json",
  "$ref": "#/$defs/InterventionDecision",
  "$defs": {
    "Decision": {
      "oneOf": [
        {
          "const": "RESUME"
        },
        {
          "const": "END"
        }
      ]
    },
    "InterventionDecision": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        }
      },
      "required": [
        "session_id",
        "decision"
      ],
      "additionalProperties": false
    },
    "SessionId": {
      "$ref": "https://openit.example/contracts/v5/_common.schema.json#/$defs/SessionId"
    }
  }
}
