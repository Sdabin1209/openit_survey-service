{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/ParserOutput.json",
  "$ref": "#/$defs/ParserOutput",
  "$defs": {
    "Intent": {
      "oneOf": [
        {
          "const": "ANSWERED_INTENT"
        },
        {
          "const": "CORRECTION_MARKED"
        },
        {
          "const": "CONFIRM_YES"
        },
        {
          "const": "CONFIRM_NO"
        },
        {
          "const": "SAYS_UNKNOWN"
        },
        {
          "const": "SAYS_REFUSAL"
        },
        {
          "const": "PROGRESS_OP"
        },
        {
          "const": "GUIDE_REQUEST"
        },
        {
          "const": "USER_CALLED_STAFF"
        },
        {
          "const": "OUT_OF_SCOPE"
        },
        {
          "const": "UNRECOGNIZED"
        },
        {
          "const": "RISK_SIGNAL"
        }
      ]
    },
    "Item": {
      "type": "object",
      "properties": {
        "item_no": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_text": {
          "$ref": "#/$defs/SourceText"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "progress_op": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgressOp"
            },
            {
              "type": "null"
            }
          ]
        },
        "guide_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextSpan"
          }
        }
      },
      "required": [
        "item_no",
        "target",
        "value",
        "source_text",
        "intent",
        "progress_op",
        "guide_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "intent": {
                "enum": [
                  "ANSWERED_INTENT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "not": {
                  "enum": [
                    null
                  ]
                }
              },
              "value": {
                "not": {
                  "enum": [
                    null
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "ParserOutput": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "ProgressOp": {
      "oneOf": [
        {
          "const": "REPEAT"
        },
        {
          "const": "WAIT"
        },
        {
          "const": "LATER"
        },
        {
          "const": "STOP"
        }
      ]
    },
    "QuestionId": {
      "type": "string",
      "minLength": 1
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string"
        },
        "slot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "SourceText": {
      "type": "string",
      "minLength": 1
    },
    "Target": {
      "oneOf": [
        {
          "$ref": "#/$defs/SlotRef"
        },
        {
          "$ref": "#/$defs/WholeQuestion"
        }
      ]
    },
    "TextSpan": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "offset_unit": {
          "type": "string",
          "enum": [
            "unicode_code_point",
            "utf16_code_unit",
            "utf8_byte"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "start",
        "end",
        "offset_unit",
        "text"
      ],
      "additionalProperties": false
    },
    "WholeQuestion": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "whole_question": {
          "const": true
        }
      },
      "required": [
        "question_id",
        "whole_question"
      ],
      "additionalProperties": false
    }
  }
}
