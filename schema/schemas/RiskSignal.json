{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/RiskSignal.json",
  "$ref": "#/$defs/RiskSignal",
  "$defs": {
    "RiskSignal": {
      "type": "object",
      "description": "POST /v1/sessions/{id}/risk-signals 본문. 위험을 감지하는 쪽(외부 규칙·분류 모델)이 보낸다. 환자 발화·자유 문장 필드는 없다.",
      "properties": {
        "signal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "severity": {
          "enum": [
            "RISK",
            "CALL_STAFF"
          ],
          "default": "RISK"
        },
        "occurred_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "signal_id",
        "source",
        "code"
      ],
      "additionalProperties": false
    }
  }
}
