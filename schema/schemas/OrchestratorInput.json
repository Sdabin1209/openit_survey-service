{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/OrchestratorInput.json",
  "$ref": "#/$defs/OrchestratorInput",
  "$defs": {
    "Decision": {
      "oneOf": [
        {
          "const": "RESUME"
        },
        {
          "const": "END"
        }
      ]
    },
    "FrontendMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "session_id": {
              "$ref": "#/$defs/SessionId",
              "description": "선택(2.2.0): 생략하면 서버가 발급해 응답의 session_id로 돌려준다. 프론트가 정해 보내는 방식은 2.x에서만 허용하는 폐기 예정 방식(3.0.0 제거). PUBLIC_API.md"
            },
            "kind": {
              "const": "SESSION_START"
            },
            "subject_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/#=+-]{1,128}$(?![\\s\\S])",
              "description": "선택. 병원이 정한 불투명 환자·방문 참조(PUBLIC_API.md A절). 서비스는 세션 메타로만 저장하고 세션 문서·Trace·로그에는 넣지 않는다."
            },
            "question_set_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$(?![\\s\\S])",
              "description": "선택(survey-schema 4.0.0): 문진할 문진표 ID. 활성 문진표가 하나면 생략할 수 있고 둘 이상이면 필수다(검사는 서비스). 목록에 없으면 VALIDATION_ERROR."
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "kind": {
              "const": "UTTERANCE"
            },
            "utterance": {
              "type": "string"
            }
          },
          "required": [
            "session_id",
            "kind",
            "utterance"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "kind": {
              "const": "SESSION_END"
            }
          },
          "required": [
            "session_id",
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "InterventionDecision": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        }
      },
      "required": [
        "session_id",
        "decision"
      ],
      "additionalProperties": false
    },
    "OrchestratorInput": {
      "type": "object",
      "properties": {
        "frontend_input": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrontendMessage"
            },
            {
              "type": "null"
            }
          ]
        },
        "intervention_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterventionDecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_found": {
          "type": "boolean"
        },
        "session_question_bank_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "session_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_question_bank_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "frontend_input",
        "intervention_decision",
        "session_found",
        "session_question_bank_version",
        "session_status",
        "latest_question_bank_version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "frontend_input": {
                  "not": {
                    "enum": [
                      null
                    ]
                  }
                },
                "intervention_decision": {
                  "enum": [
                    null
                  ]
                }
              }
            },
            {
              "properties": {
                "frontend_input": {
                  "enum": [
                    null
                  ]
                },
                "intervention_decision": {
                  "not": {
                    "enum": [
                      null
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "session_found": {
                "enum": [
                  false
                ]
              }
            }
          },
          "then": {
            "properties": {
              "session_status": {
                "enum": [
                  null
                ]
              },
              "session_question_bank_version": {
                "enum": [
                  null
                ]
              }
            }
          },
          "else": {
            "properties": {
              "session_status": {
                "not": {
                  "enum": [
                    null
                  ]
                }
              },
              "session_question_bank_version": {
                "not": {
                  "enum": [
                    null
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "SessionId": {
      "type": "string",
      "minLength": 1
    },
    "SessionStatus": {
      "oneOf": [
        {
          "const": "IN_PROGRESS"
        },
        {
          "const": "PAUSED_RISK"
        },
        {
          "const": "ENDED_COMPLETE"
        },
        {
          "const": "ENDED_STAFF"
        },
        {
          "const": "ENDED_LEFT"
        },
        {
          "const": "ENDED_USER_STOP"
        }
      ]
    }
  }
}
