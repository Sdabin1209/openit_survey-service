{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/FrontendInput.json",
  "$ref": "#/$defs/FrontendInput",
  "$defs": {
    "FrontendInput": {
      "type": "object",
      "properties": {
        "response_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_failure_signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnFailureSignal"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "description": "세션 시작(POST /v1/sessions) 응답에서 서버가 session_id를 발급했을 때만 있다(2.2.0). 이후 경로의 {session_id}에 쓴다. 다른 응답과 프론트가 ID를 정해 보낸 시작 응답에는 없다. PUBLIC_API.md"
        }
      },
      "required": [
        "response_text",
        "turn_failure_signal"
      ],
      "additionalProperties": false
    },
    "SessionId": {
      "type": "string",
      "minLength": 1
    },
    "TurnFailureSignal": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "write_committed": {
          "oneOf": [
            {
              "const": "COMMITTED"
            },
            {
              "const": "NOT_COMMITTED"
            }
          ]
        },
        "staff_alert": {
          "oneOf": [
            {
              "const": "NONE"
            },
            {
              "const": "DELIVERED"
            },
            {
              "const": "DELIVERY_FAILED"
            }
          ]
        },
        "pause_reason": {
          "description": "정지 사유(2.1.0, CR-H002). 위험 신호/위험 규칙은 RISK, 되묻기 한도 초과는 REASK_LIMIT, 그 밖은 OTHER. optional: 없으면 미상. 읽는 쪽은 모르는 값을 OTHER로 취급한다.",
          "oneOf": [
            {
              "const": "RISK"
            },
            {
              "const": "REASK_LIMIT"
            },
            {
              "const": "OTHER"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "write_committed",
        "staff_alert"
      ],
      "additionalProperties": false
    }
  }
}
