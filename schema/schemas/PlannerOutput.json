{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/PlannerOutput.json",
  "$ref": "#/$defs/PlannerOutput",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "const": "ASK_NEXT"
        },
        {
          "const": "ASK_MISSING"
        },
        {
          "const": "ASK_CLARIFY"
        },
        {
          "const": "ASK_CONFIRM"
        },
        {
          "const": "ASK_AFTER_UNKNOWN"
        },
        {
          "const": "ASK_AFTER_REFUSAL"
        },
        {
          "const": "ASK_CORRECTION_TARGET"
        },
        {
          "const": "ASK_FINISH"
        },
        {
          "const": "ASK_STOP"
        },
        {
          "const": "ASK_REPEAT"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "REDIRECT"
        },
        {
          "const": "RISK_NOTICE"
        },
        {
          "const": "WAIT_NOTICE"
        },
        {
          "const": "STAFF_NOTICE"
        },
        {
          "const": "FAREWELL"
        }
      ]
    },
    "AlertKind": {
      "oneOf": [
        {
          "const": "RISK"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "USER_CALLED_STAFF"
        }
      ]
    },
    "AskAction": {
      "oneOf": [
        {
          "const": "ASK_NEXT"
        },
        {
          "const": "ASK_MISSING"
        },
        {
          "const": "ASK_CLARIFY"
        },
        {
          "const": "ASK_CONFIRM"
        },
        {
          "const": "ASK_AFTER_UNKNOWN"
        },
        {
          "const": "ASK_AFTER_REFUSAL"
        },
        {
          "const": "ASK_CORRECTION_TARGET"
        },
        {
          "const": "ASK_FINISH"
        },
        {
          "const": "ASK_STOP"
        }
      ]
    },
    "AskDirective": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/AskAction"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          }
        },
        "target_pending_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingId"
            },
            {
              "type": "null"
            }
          ]
        },
        "say_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SayValue"
          }
        }
      },
      "required": [
        "action",
        "targets",
        "target_pending_id",
        "say_values"
      ],
      "additionalProperties": false
    },
    "AskSubject": {
      "oneOf": [
        {
          "$ref": "#/$defs/Target"
        },
        {
          "type": "object",
          "properties": {
            "untargeted": {
              "oneOf": [
                {
                  "const": "ASK_FINISH"
                },
                {
                  "const": "ASK_STOP"
                },
                {
                  "const": "ASK_CORRECTION_TARGET"
                }
              ]
            }
          },
          "required": [
            "untargeted"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CodedValue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "Directive": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          }
        },
        "target_pending_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingId"
            },
            {
              "type": "null"
            }
          ]
        },
        "awaiting": {
          "anyOf": [
            {
              "$ref": "#/$defs/AskDirective"
            },
            {
              "type": "null"
            }
          ]
        },
        "say_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SayValue"
          }
        },
        "reask_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "uniqueItems": true
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Notice"
          }
        },
        "sentence_materials": {
          "$ref": "#/$defs/SentenceMaterials"
        }
      },
      "required": [
        "action",
        "targets",
        "target_pending_id",
        "awaiting",
        "say_values",
        "reask_reasons",
        "notices",
        "sentence_materials"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "offset_unit": {
          "type": "string",
          "enum": [
            "unicode_code_point",
            "utf16_code_unit",
            "utf8_byte"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "turn_index",
        "start",
        "end",
        "offset_unit",
        "text"
      ],
      "additionalProperties": false
    },
    "FixedSentenceKey": {
      "oneOf": [
        {
          "const": "ASK_REPEAT"
        },
        {
          "const": "OOS_NOTICE"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "FAREWELL"
        },
        {
          "const": "ASK_CONFIRM"
        },
        {
          "const": "ASK_CORRECTION_TARGET"
        },
        {
          "const": "ASK_FINISH"
        },
        {
          "const": "RISK_NOTICE"
        },
        {
          "const": "RESUME"
        },
        {
          "const": "SURVEY_STOPPED"
        },
        {
          "const": "WAIT_NOTICE"
        },
        {
          "const": "ASK_STOP"
        },
        {
          "const": "STAFF_NOTICE"
        },
        {
          "const": "DEFERRED"
        }
      ]
    },
    "Flow": {
      "oneOf": [
        {
          "const": "CONTINUE"
        },
        {
          "const": "END"
        }
      ]
    },
    "Notice": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/NoticeKind"
        },
        "guide_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "question_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/SlotRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        },
        "previous_value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        }
      },
      "required": [
        "kind",
        "guide_id",
        "question_id",
        "question_name",
        "slot",
        "previous_value",
        "value"
      ],
      "additionalProperties": false
    },
    "NoticeKind": {
      "oneOf": [
        {
          "const": "CORRECTION_ACK"
        },
        {
          "const": "KEPT_PREVIOUS"
        },
        {
          "const": "RESUME"
        },
        {
          "const": "SURVEY_STOPPED"
        },
        {
          "const": "GUIDE"
        },
        {
          "const": "DEFERRED"
        }
      ]
    },
    "OpenRequests": {
      "type": "object",
      "properties": {
        "correction_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Target"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "target"
            ],
            "additionalProperties": false
          }
        },
        "stop_requested": {
          "type": "boolean"
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "oneOf": [
                  {
                    "const": "QUESTION"
                  },
                  {
                    "const": "PENDING"
                  },
                  {
                    "const": "CORRECTION_REQUEST"
                  }
                ]
              },
              "target": {
                "$ref": "#/$defs/Target"
              }
            },
            "required": [
              "kind",
              "target"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "correction_requests",
        "stop_requested",
        "deferred"
      ],
      "additionalProperties": false
    },
    "PauseEntry": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PauseKind"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseReason"
          }
        }
      },
      "required": [
        "kind",
        "reasons"
      ],
      "additionalProperties": false
    },
    "PauseKind": {
      "oneOf": [
        {
          "const": "PAUSE"
        },
        {
          "const": "RESUME"
        }
      ]
    },
    "PauseReason": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_SIGNAL"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_RULE"
            },
            "target": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SlotRef"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PendingId": {
      "type": "string",
      "minLength": 1
    },
    "PlannerOutput": {
      "type": "object",
      "properties": {
        "directive": {
          "$ref": "#/$defs/Directive"
        },
        "flow": {
          "$ref": "#/$defs/Flow"
        },
        "staff_alert": {
          "anyOf": [
            {
              "$ref": "#/$defs/StaffAlert"
            },
            {
              "type": "null"
            }
          ]
        },
        "progress_record_update": {
          "$ref": "#/$defs/ProgressRecordUpdate"
        },
        "planner_record_update": {
          "$ref": "#/$defs/PlannerRecord"
        }
      },
      "required": [
        "directive",
        "flow",
        "staff_alert",
        "progress_record_update",
        "planner_record_update"
      ],
      "additionalProperties": false
    },
    "PlannerRecord": {
      "type": "object",
      "properties": {
        "attempt_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "question_id",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "confirm_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "$ref": "#/$defs/SlotRef"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "slot",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "unknown_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "question_id",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "refusal_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "question_id",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "unrecognized_streak": {
          "type": "integer",
          "minimum": 0
        },
        "ask_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "$ref": "#/$defs/AskSubject"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "subject",
              "count"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "attempt_counts",
        "confirm_counts",
        "unknown_counts",
        "refusal_counts",
        "unrecognized_streak",
        "ask_counts"
      ],
      "additionalProperties": false
    },
    "Precision": {
      "type": "string",
      "enum": [
        "exact",
        "approximate",
        "unspecified"
      ]
    },
    "ProgressRecordUpdate": {
      "type": "object",
      "properties": {
        "last_directive": {
          "$ref": "#/$defs/Directive"
        },
        "open_requests": {
          "$ref": "#/$defs/OpenRequests"
        },
        "skipped_add": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkipEntry"
          }
        },
        "skipped_remove": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionId"
          },
          "uniqueItems": true
        },
        "confirm_stopped_add": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          }
        },
        "confirm_stopped_remove": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          }
        },
        "session_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "pause_history_add": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseEntry"
          }
        }
      },
      "required": [
        "last_directive",
        "open_requests",
        "skipped_add",
        "skipped_remove",
        "confirm_stopped_add",
        "confirm_stopped_remove",
        "session_status",
        "pause_history_add"
      ],
      "additionalProperties": false
    },
    "QuestionId": {
      "type": "string",
      "minLength": 1
    },
    "Reason": {
      "oneOf": [
        {
          "const": "NO_UNIT"
        },
        {
          "const": "OUT_OF_RANGE"
        },
        {
          "const": "AMBIGUOUS"
        },
        {
          "const": "MISMATCH"
        },
        {
          "const": "UNRECOGNIZED"
        },
        {
          "const": "MISSING_SLOT"
        }
      ]
    },
    "SayValue": {
      "type": "object",
      "properties": {
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "question_name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/Value"
        },
        "role": {
          "oneOf": [
            {
              "const": "CURRENT"
            },
            {
              "const": "PENDING"
            },
            {
              "const": "JUST_SAVED"
            },
            {
              "const": "SAID"
            }
          ]
        },
        "value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        }
      },
      "required": [
        "slot",
        "question_name",
        "value",
        "role"
      ],
      "additionalProperties": false
    },
    "SentenceMaterials": {
      "type": "object",
      "properties": {
        "question_sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "question_id",
              "sentence"
            ],
            "additionalProperties": false
          }
        },
        "refusal_explanations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "question_id",
              "sentence"
            ],
            "additionalProperties": false
          }
        },
        "reask_sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "$ref": "#/$defs/SlotRef"
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "slot",
              "sentence"
            ],
            "additionalProperties": false
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "$ref": "#/$defs/SlotRef"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "slot",
              "choices"
            ],
            "additionalProperties": false
          }
        },
        "guide_sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "guide_id": {
                "type": "string",
                "minLength": 1
              },
              "question_id": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/QuestionId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "guide_id",
              "question_id",
              "sentence"
            ],
            "additionalProperties": false
          }
        },
        "fixed_sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/FixedSentenceKey"
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "key",
              "sentence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "question_sentences",
        "refusal_explanations",
        "reask_sentences",
        "choices",
        "guide_sentences",
        "fixed_sentences"
      ],
      "additionalProperties": false
    },
    "SessionStatus": {
      "oneOf": [
        {
          "const": "IN_PROGRESS"
        },
        {
          "const": "PAUSED_RISK"
        },
        {
          "const": "ENDED_COMPLETE"
        },
        {
          "const": "ENDED_STAFF"
        },
        {
          "const": "ENDED_LEFT"
        },
        {
          "const": "ENDED_USER_STOP"
        }
      ]
    },
    "SkipEntry": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "reason": {
          "$ref": "#/$defs/SkipReason"
        }
      },
      "required": [
        "question_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "SkipReason": {
      "oneOf": [
        {
          "const": "UNKNOWN_ACCEPTED"
        },
        {
          "const": "REFUSAL_ACCEPTED"
        },
        {
          "const": "ATTEMPTS_EXCEEDED"
        }
      ]
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string"
        },
        "slot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "SourceText": {
      "type": "string",
      "minLength": 1
    },
    "StaffAlert": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AlertKind"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StaffAlertReason"
          }
        }
      },
      "required": [
        "kind",
        "reasons"
      ],
      "additionalProperties": false
    },
    "StaffAlertReason": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_SIGNAL"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_RULE"
