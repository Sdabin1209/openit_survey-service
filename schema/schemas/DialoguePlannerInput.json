{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standalone/DialoguePlannerInput.json",
  "$ref": "#/$defs/DialoguePlannerInput",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "const": "ASK_NEXT"
        },
        {
          "const": "ASK_MISSING"
        },
        {
          "const": "ASK_CLARIFY"
        },
        {
          "const": "ASK_CONFIRM"
        },
        {
          "const": "ASK_AFTER_UNKNOWN"
        },
        {
          "const": "ASK_AFTER_REFUSAL"
        },
        {
          "const": "ASK_CORRECTION_TARGET"
        },
        {
          "const": "ASK_FINISH"
        },
        {
          "const": "ASK_STOP"
        },
        {
          "const": "ASK_REPEAT"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "REDIRECT"
        },
        {
          "const": "RISK_NOTICE"
        },
        {
          "const": "WAIT_NOTICE"
        },
        {
          "const": "STAFF_NOTICE"
        },
        {
          "const": "FAREWELL"
        }
      ]
    },
    "AskAction": {
      "oneOf": [
        {
          "const": "ASK_NEXT"
        },
        {
          "const": "ASK_MISSING"
        },
        {
          "const": "ASK_CLARIFY"
        },
        {
          "const": "ASK_CONFIRM"
        },
        {
          "const": "ASK_AFTER_UNKNOWN"
        },
        {
          "const": "ASK_AFTER_REFUSAL"
        },
        {
          "const": "ASK_CORRECTION_TARGET"
        },
        {
          "const": "ASK_FINISH"
        },
        {
          "const": "ASK_STOP"
        }
      ]
    },
    "AskDirective": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/AskAction"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          }
        },
        "target_pending_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingId"
            },
            {
              "type": "null"
            }
          ]
        },
        "say_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SayValue"
          }
        }
      },
      "required": [
        "action",
        "targets",
        "target_pending_id",
        "say_values"
      ],
      "additionalProperties": false
    },
    "AskSubject": {
      "oneOf": [
        {
          "$ref": "#/$defs/Target"
        },
        {
          "type": "object",
          "properties": {
            "untargeted": {
              "oneOf": [
                {
                  "const": "ASK_FINISH"
                },
                {
                  "const": "ASK_STOP"
                },
                {
                  "const": "ASK_CORRECTION_TARGET"
                }
              ]
            }
          },
          "required": [
            "untargeted"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ChangedSlot": {
      "type": "object",
      "properties": {
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "previous_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_value": {
          "$ref": "#/$defs/Value"
        },
        "kind": {
          "oneOf": [
            {
              "const": "FIRST_ANSWER"
            },
            {
              "const": "CORRECTION"
            }
          ]
        }
      },
      "required": [
        "slot",
        "previous_value",
        "new_value",
        "kind"
      ],
      "additionalProperties": false
    },
    "ChoiceDef": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "code",
        "label",
        "synonyms"
      ],
      "additionalProperties": false
    },
    "CodedValue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "CurrentValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "answer": {
              "$ref": "#/$defs/Value"
            }
          },
          "required": [
            "answer"
          ],
          "additionalProperties": false
        },
        {
          "const": "UNKNOWN_RECORD"
        },
        {
          "const": "REFUSAL_RECORD"
        },
        {
          "const": "NONE"
        }
      ]
    },
    "DialoguePlannerInput": {
      "type": "object",
      "properties": {
        "turn_kind": {
          "$ref": "#/$defs/TurnKind"
        },
        "utterance_judgment": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtteranceJudgment"
            },
            {
              "type": "null"
            }
          ]
        },
        "judgments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Judgment"
          }
        },
        "store_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoreSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "answer_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRecord"
          }
        },
        "last_directive": {
          "anyOf": [
            {
              "$ref": "#/$defs/Directive"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkipEntry"
          }
        },
        "confirm_stopped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          }
        },
        "open_requests": {
          "$ref": "#/$defs/OpenRequests"
        },
        "planner_record": {
          "$ref": "#/$defs/PlannerRecord"
        },
        "question_bank": {
          "$ref": "#/$defs/QuestionBank"
        }
      },
      "required": [
        "turn_kind",
        "utterance_judgment",
        "judgments",
        "store_summary",
        "answer_records",
        "last_directive",
        "skipped",
        "confirm_stopped",
        "open_requests",
        "planner_record",
        "question_bank"
      ],
      "additionalProperties": false
    },
    "Directive": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          }
        },
        "target_pending_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingId"
            },
            {
              "type": "null"
            }
          ]
        },
        "awaiting": {
          "anyOf": [
            {
              "$ref": "#/$defs/AskDirective"
            },
            {
              "type": "null"
            }
          ]
        },
        "say_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SayValue"
          }
        },
        "reask_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "uniqueItems": true
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Notice"
          }
        },
        "sentence_materials": {
          "$ref": "#/$defs/SentenceMaterials"
        }
      },
      "required": [
        "action",
        "targets",
        "target_pending_id",
        "awaiting",
        "say_values",
        "reask_reasons",
        "notices",
        "sentence_materials"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "offset_unit": {
          "type": "string",
          "enum": [
            "unicode_code_point",
            "utf16_code_unit",
            "utf8_byte"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "turn_index",
        "start",
        "end",
        "offset_unit",
        "text"
      ],
      "additionalProperties": false
    },
    "FillValue": {
      "oneOf": [
        {
          "const": "REMAINING_COUNT"
        }
      ]
    },
    "FixedSentence": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/FixedSentenceKey"
        },
        "sentence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "sentence"
      ],
      "additionalProperties": false
    },
    "FixedSentenceKey": {
      "oneOf": [
        {
          "const": "ASK_REPEAT"
        },
        {
          "const": "OOS_NOTICE"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "FAREWELL"
        },
        {
          "const": "ASK_CONFIRM"
        },
        {
          "const": "ASK_CORRECTION_TARGET"
        },
        {
          "const": "ASK_FINISH"
        },
        {
          "const": "RISK_NOTICE"
        },
        {
          "const": "RESUME"
        },
        {
          "const": "SURVEY_STOPPED"
        },
        {
          "const": "WAIT_NOTICE"
        },
        {
          "const": "ASK_STOP"
        },
        {
          "const": "STAFF_NOTICE"
        },
        {
          "const": "DEFERRED"
        }
      ]
    },
    "GuideItem": {
      "type": "object",
      "properties": {
        "guide_id": {
          "type": "string",
          "minLength": 1
        },
        "selection_criterion": {
          "type": "string",
          "minLength": 1
        },
        "per_question": {
          "type": "boolean"
        },
        "sentence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "fill_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/FillValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "guide_id",
        "selection_criterion",
        "per_question",
        "sentence",
        "fill_value"
      ],
      "additionalProperties": false
    },
    "HistoryEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/Value"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/Value"
            },
            "value_metadata": {
              "$ref": "#/$defs/ValueMetadata"
            }
          },
          "required": [
            "value",
            "value_metadata"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Judgment": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/Target"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgmentStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "uniqueItems": true
        },
        "value_now": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "said_value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_handling": {
          "oneOf": [
            {
              "const": "CREATE"
            },
            {
              "const": "ACCEPT"
            },
            {
              "const": "DROP"
            },
            {
              "const": "NONE"
            }
          ]
        },
        "target_pending_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingId"
          }
        },
        "mismatched_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          }
        },
        "risk_rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        },
        "problem_details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProblemDetail"
          }
        }
      },
      "required": [
        "target",
        "status",
        "reasons",
        "value_now",
        "said_value",
        "pending_handling",
        "target_pending_ids",
        "mismatched_slots",
        "risk_rule"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "value_metadata"
            ],
            "properties": {
              "value_metadata": {
                "properties": {
                  "precision": {
                    "enum": [
                      "exact",
                      "approximate"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value_now": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "JudgmentStatus": {
      "oneOf": [
        {
          "const": "ANSWERED"
        },
        {
          "const": "MISSING"
        },
        {
          "const": "UNCLEAR"
        },
        {
          "const": "CONFLICT"
        },
        {
          "const": "CORRECTION"
        },
        {
          "const": "UNKNOWN"
        },
        {
          "const": "REJECTED"
        },
        {
          "const": "PREREQUISITE_UNMET"
        }
      ]
    },
    "Notice": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/NoticeKind"
        },
        "guide_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "question_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/SlotRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        },
        "previous_value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        }
      },
      "required": [
        "kind",
        "guide_id",
        "question_id",
        "question_name",
        "slot",
        "previous_value",
        "value"
      ],
      "additionalProperties": false
    },
    "NoticeKind": {
      "oneOf": [
        {
          "const": "CORRECTION_ACK"
        },
        {
          "const": "KEPT_PREVIOUS"
        },
        {
          "const": "RESUME"
        },
        {
          "const": "SURVEY_STOPPED"
        },
        {
          "const": "GUIDE"
        },
        {
          "const": "DEFERRED"
        }
      ]
    },
    "OpenRequests": {
      "type": "object",
      "properties": {
        "correction_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Target"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "target"
            ],
            "additionalProperties": false
          }
        },
        "stop_requested": {
          "type": "boolean"
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "oneOf": [
                  {
                    "const": "QUESTION"
                  },
                  {
                    "const": "PENDING"
                  },
                  {
                    "const": "CORRECTION_REQUEST"
                  }
                ]
              },
              "target": {
                "$ref": "#/$defs/Target"
              }
            },
            "required": [
              "kind",
              "target"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "correction_requests",
        "stop_requested",
        "deferred"
      ],
      "additionalProperties": false
    },
    "PendingId": {
      "type": "string",
      "minLength": 1
    },
    "PendingRecord": {
      "type": "object",
      "properties": {
        "pending_id": {
          "$ref": "#/$defs/PendingId"
        },
        "value": {
          "$ref": "#/$defs/Value"
        },
        "risk_mark": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_metadata": {
          "$ref": "#/$defs/ValueMetadata"
        }
      },
      "required": [
        "pending_id",
        "value",
        "risk_mark"
      ],
      "additionalProperties": false
    },
    "PlannerRecord": {
      "type": "object",
      "properties": {
        "attempt_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "question_id",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "confirm_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "$ref": "#/$defs/SlotRef"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "slot",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "unknown_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "question_id",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "refusal_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "question_id",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "unrecognized_streak": {
          "type": "integer",
          "minimum": 0
        },
        "ask_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "$ref": "#/$defs/AskSubject"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "subject",
              "count"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "attempt_counts",
        "confirm_counts",
        "unknown_counts",
        "refusal_counts",
        "unrecognized_streak",
        "ask_counts"
      ],
      "additionalProperties": false
    },
    "Policy": {
      "type": "object",
      "properties": {
        "question_limit": {
          "type": "integer",
          "minimum": 1
        },
        "unknown_accept_after": {
          "type": "integer",
          "minimum": 1
        },
        "refusal_accept_after": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "question_limit",
        "unknown_accept_after",
        "refusal_accept_after"
      ],
      "additionalProperties": false
    },
    "Precision": {
      "type": "string",
      "enum": [
        "exact",
        "approximate",
        "unspecified"
      ]
    },
    "Prerequisite": {
      "type": "object",
      "properties": {
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "slot",
        "value"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "oneOf": [
        {
          "const": "NO_UNIT"
        },
        {
          "const": "OUT_OF_RANGE"
        },
        {
          "const": "AMBIGUOUS"
        },
        {
          "const": "MISMATCH"
        },
        {
          "const": "UNKNOWN_TARGET"
        }
      ]
    },
    "ProblemDetail": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/Problem"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          }
        },
        "message": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "category",
        "code",
        "refs",
        "message"
      ],
