{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PushSubscribeBody",
  "description": "POST /v1/staff/push-subscriptions 본문(웹 푸시 구독 등록). endpoint 문법은 SSRF 방어의 문법 검사(https, 사용자 정보 없음, 포트 443, 공개 호스트 이름 형태)를 옮긴 것이다. 개발·시험용 SURVEY_PUSH_ALLOW_PRIVATE_HOSTS=true이면 이 문법 검사를 하지 않는다.",
  "type": "object",
  "required": [
    "endpoint",
    "keys"
  ],
  "additionalProperties": false,
  "properties": {
    "endpoint": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^/?#@:\\s]+\\.[^/?#@:\\s]+(:443)?([/?#]\\S*)?$(?![\\s\\S])",
      "allOf": [
        {
          "not": {
            "pattern": "^https://[lL][oO][cC][aA][lL][hH][oO][sS][tT]\\.?(:443)?([/?#]|$)"
          }
        },
        {
          "not": {
            "pattern": "^https://[^/?#@:\\s]*\\.([lL][oO][cC][aA][lL]|[lL][oO][cC][aA][lL][dD][oO][mM][aA][iI][nN]|[iI][nN][tT][eE][rR][nN][aA][lL]|[lL][aA][nN]|[hH][oO][mM][eE]|[cC][oO][rR][pP]|[iI][nN][tT][rR][aA][nN][eE][tT])\\.?(:443)?([/?#]|$)"
          }
        }
      ],
      "description": "웹 푸시 endpoint"
    },
    "keys": {
      "type": "object",
      "required": [
        "p256dh",
        "auth"
      ],
      "properties": {
        "p256dh": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expirationTime": {}
  }
}
