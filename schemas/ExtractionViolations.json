{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtractionViolations",
  "description": "추출 결과 검사의 위반 목록(extraction_check 출력). 빈 배열이면 위반 없음. 값 자체는 싣지 않는다.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "code",
      "path",
      "message"
    ],
    "properties": {
      "code": {
        "enum": [
          "UNKNOWN_SLOT",
          "OUT_OF_CURRENT_ITEM"
        ]
      },
      "path": {
        "type": "string",
        "pattern": "^values/[0-9]+/key$",
        "description": "위반한 values 항목의 키 경로."
      },
      "message": {
        "type": "string",
        "minLength": 1
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "code": {
              "const": "UNKNOWN_SLOT"
            }
          },
          "required": [
            "code"
          ]
        },
        "then": {
          "properties": {
            "message": {
              "const": "저장하려는 칸이 문항 세트에 없다"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "code": {
              "const": "OUT_OF_CURRENT_ITEM"
            }
          },
          "required": [
            "code"
          ]
        },
        "then": {
          "properties": {
            "message": {
              "const": "현재 문항이 아닌 칸을 정정이 아닌데 저장하려 한다"
            }
          }
        }
      }
    ]
  }
}
