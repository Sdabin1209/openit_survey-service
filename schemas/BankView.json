{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BankView",
  "description": "정리된 문항 세트(question_bank_view 출력). questions는 order 오름차순이다(정렬은 스키마로 표현하지 못한다). 각 문항은 문진 스키마 QuestionDef 그대로이고 여기서는 이 컴포넌트가 읽는 키만 적는다(질문 문장 찾기, 고정 문장 찾기의 재료).",
  "type": "object",
  "required": [
    "questions",
    "session_settings"
  ],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "order",
          "question_sentence"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer"
          },
          "question_sentence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "session_settings": {
      "type": "object",
      "required": [
        "fixed_sentences"
      ],
      "properties": {
        "fixed_sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "sentence"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "sentence": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
