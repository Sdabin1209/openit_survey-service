{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnWriteSet",
  "description": "한 턴의 저장 갱신과 진행 갱신 계획(write_plan 출력, session_store가 쓰기 효과로 적용). answer_updates는 값이 달라진 칸만 담는다. 진행 갱신에서 다음 문항이 END면 세션 상태를 ENDED_COMPLETE로 바꾸고 열린 칸을 비운다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer_updates",
    "progress_record_update"
  ],
  "properties": {
    "answer_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "action",
          "value",
          "precision"
        ],
        "properties": {
          "slot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_id",
              "repeat_key",
              "slot_id"
            ],
            "properties": {
              "question_id": {
                "type": "string",
                "minLength": 1
              },
              "repeat_key": {
                "type": "string"
              },
              "slot_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "action": {
            "enum": [
              "FIRST_WRITE",
              "NEW_REVISION"
            ],
            "description": "처음 쓰기 / 값이 달라져 새 판."
          },
          "value": {
            "type": [
              "boolean",
              "number",
              "string"
            ],
            "description": "저장하는 값(save=true는 null이 아니다)."
          },
          "precision": {
            "enum": [
              "exact",
              "approximate"
            ]
          }
        }
      }
    },
    "progress_record_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_question_id",
        "open_slots",
        "skipped_add",
        "skipped_remove",
        "session_status",
        "pause_history_add"
      ],
      "properties": {
        "current_question_id": {
          "type": "string",
          "pattern": "^(END|Q[0-9]+(\\.D[0-9]{2})?(_[0-9]+)?)$",
          "description": "다음에 물을 문항 또는 END."
        },
        "open_slots": {
          "type": "array",
          "description": "다음 문항에 속한 열린 칸(MISSING·UNCLEAR). END면 비어 있다.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "status"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "MISSING",
                  "UNCLEAR"
                ]
              }
            }
          }
        },
        "skipped_add": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_id",
              "reason"
            ],
            "properties": {
              "question_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "REQUEST_SKIP",
                  "REFUSED",
                  "UNCERTAIN"
                ]
              }
            }
          }
        },
        "skipped_remove": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "session_status": {
          "enum": [
            "ENDED_COMPLETE",
            null
          ],
          "description": "다음 문항이 END일 때만 ENDED_COMPLETE, 아니면 null(바꾸지 않음)."
        },
        "pause_history_add": {
          "type": "array",
          "maxItems": 0,
          "description": "이 컴포넌트는 멈춤 기록을 더하지 않는다(항상 빈 배열)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "current_question_id": {
                "const": "END"
              }
            },
            "required": [
              "current_question_id"
            ]
          },
          "then": {
            "properties": {
              "session_status": {
                "const": "ENDED_COMPLETE"
              },
              "open_slots": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "session_status": {
                "const": null
              }
            }
          }
        }
      ]
    }
  }
}
