{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnRequest",
  "description": "wiring/orchestrator의 handle_turn 입력. frontend_message(키오스크의 FrontendMessage)와 intervention_decision(직원의 InterventionDecision) 중 정확히 하나가 객체이고 다른 하나는 null이다. 각 모양은 문진 스키마 FrontendMessage, InterventionDecision의 부분집합이며 handle_turn이 요구하는 조건(세션 ID 필수, 처리하는 kind)을 더한다.",
  "type": "object",
  "required": ["turn_id", "frontend_message", "intervention_decision"],
  "additionalProperties": false,
  "properties": {
    "turn_id": {"type": "string", "minLength": 1},
    "frontend_message": {
      "type": ["object", "null"],
      "required": ["session_id", "kind"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["SESSION_START", "UTTERANCE", "SESSION_END"]}
      },
      "if": {"properties": {"kind": {"const": "UTTERANCE"}}, "required": ["kind"]},
      "then": {"required": ["utterance"], "properties": {"utterance": {"type": "string"}}}
    },
    "intervention_decision": {
      "type": ["object", "null"],
      "required": ["session_id", "decision"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "decision": {"enum": ["RESUME", "END"]}
      }
    }
  },
  "oneOf": [
    {"properties": {"frontend_message": {"type": "object"}, "intervention_decision": {"type": "null"}}},
    {"properties": {"frontend_message": {"type": "null"}, "intervention_decision": {"type": "object"}}}
  ]
}
