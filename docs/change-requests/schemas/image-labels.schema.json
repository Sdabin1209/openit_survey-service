{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "survey-service/image-labels.schema.json",
  "title": "SurveyImageLabels",
  "description": "survey-service 이미지의 라벨. 공통 6개 키(D50)에 서비스 고유 키 io.openit.langgraph를 더한다(CR-011, D63). 만드는 쪽: survey-service Dockerfile. 읽는 쪽: deploy(배포 전 검사). io.openit.* 의 모르는 키는 거부한다(오타·이름 변경을 배포 전에 잡는다). 다른 접두사는 무시.",
  "type": "object",
  "required": [
    "io.openit.service",
    "io.openit.revision",
    "io.openit.contracts.boundary",
    "io.openit.contracts.survey-schema",
    "io.openit.turn-engine",
    "io.openit.model-runtime",
    "io.openit.langgraph"
  ],
  "propertyNames": {
    "anyOf": [
      {
        "not": {
          "pattern": "^io\\.openit\\."
        }
      },
      {
        "enum": [
          "io.openit.service",
          "io.openit.revision",
          "io.openit.contracts.boundary",
          "io.openit.contracts.survey-schema",
          "io.openit.turn-engine",
          "io.openit.model-runtime",
          "io.openit.langgraph"
        ]
      }
    ]
  },
  "properties": {
    "io.openit.service": {
      "const": "survey-service"
    },
    "io.openit.revision": {
      "type": "string",
      "pattern": "^([0-9a-f]{7,40}|unknown)$"
    },
    "io.openit.contracts.boundary": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "io.openit.contracts.survey-schema": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "io.openit.turn-engine": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "io.openit.model-runtime": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "io.openit.langgraph": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "additionalProperties": {
    "type": "string"
  }
}
