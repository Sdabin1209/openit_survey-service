{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SurveyPurgeOutput.schema.json",
  "title": "SurveyPurgeOutput",
  "description": "`python -m survey_service purge [--session <id>]`가 표준 출력에 내는 한 줄(JSON). 만드는 쪽: survey-service(retention.py run_purge). 읽는 쪽: deploy(보존 기간 점검·잡 로그). 종료 코드: 0 성공, 2 설정 오류, 3 저장소를 열 수 없음(이때 표준 오류에 한국어 한 줄, 표준 출력은 비어 있다). 모르는 키는 읽는 쪽이 무시한다.",
  "type": "object",
  "required": [
    "event",
    "purged_sessions"
  ],
  "properties": {
    "event": {
      "const": "session_purge"
    },
    "configured": {
      "type": "boolean"
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1
    },
    "purged_sessions": {
      "type": "integer",
      "minimum": 0
    },
    "purged_access_log": {
      "type": "integer",
      "minimum": 0
    },
    "purged_alerts": {
      "type": "integer",
      "minimum": 0
    },
    "purged_dead_outbox": {
      "type": "integer",
      "minimum": 0
    }
  }
}
