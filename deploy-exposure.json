{
  "service": "survey-service",
  "routes": [
    {
      "paths": [
        "/readyz"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "none"
      },
      "user_header": "strip",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 2000
      }
    },
    {
      "paths": [
        "/v1/sessions",
        "/v1/sessions/*/turns",
        "/v1/sessions/*/end",
        "/v1/sessions/*/staff-call/retry",
        "/v1/sessions/*/staff-call/report"
      ],
      "methods": [
        "POST"
      ],
      "auth": {
        "kind": "device"
      },
      "user_header": "strip",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 55000
      },
      "upstream_token": "survey-api-kiosk",
      "max_body_bytes": 65536
    },
    {
      "paths": [
        "/v1/question-sets",
        "/v1/sessions/*/state"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "device"
      },
      "user_header": "strip",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 55000
      },
      "upstream_token": "survey-api-kiosk"
    },
    {
      "paths": [
        "/v1/staff/alerts",
        "/v1/staff/alerts/stream",
        "/v1/staff/sessions/*",
        "/v1/staff/push-config"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "staff"
        ]
      },
      "upstream_token": "survey-api-staff",
      "user_header": "set",
      "streaming": true,
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 55000,
        "read": 3600000
      }
    },
    {
      "paths": [
        "/v1/staff/push-subscriptions",
        "/v1/staff/push-subscriptions/unsubscribe",
        "/v1/sessions/*/intervention"
      ],
      "methods": [
        "POST"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "staff"
        ]
      },
      "upstream_token": "survey-api-staff",
      "user_header": "set",
      "streaming": true,
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 55000,
        "read": 3600000
      },
      "max_body_bytes": 65536
    },
    {
      "paths": [
        "/v1/results",
        "/v1/results/*"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "clinician"
        ]
      },
      "upstream_token": "survey-result-reader",
      "user_header": "set",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 55000
      }
    },
    {
      "paths": [
        "/v1/results/*/ack"
      ],
      "methods": [
        "POST"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "clinician"
        ]
      },
      "upstream_token": "survey-result-reader",
      "user_header": "set",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 55000
      },
      "max_body_bytes": 65536
    },
    {
      "paths": [
        "/v1/staff/push-config"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "clinician"
        ]
      },
      "upstream_token": "survey-result-reader",
      "user_header": "set",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 55000
      }
    },
    {
      "paths": [
        "/v1/staff/push-subscriptions",
        "/v1/staff/push-subscriptions/unsubscribe"
      ],
      "methods": [
        "POST"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "clinician"
        ]
      },
      "upstream_token": "survey-result-reader",
      "user_header": "set",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 55000
      },
      "max_body_bytes": 65536
    },
    {
      "paths": [
        "/v1/sessions/*/risk-signals",
        "/metrics"
      ],
      "auth": {
        "kind": "denied"
      }
    },
    {
      "paths": [
        "/v1/staff/alerts/stream"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "clinician"
        ]
      },
      "upstream_token": "survey-result-reader",
      "user_header": "set",
      "streaming": true,
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 55000,
        "read": 3600000
      }
    }
  ],
  "egress": [
    "release-gate",
    "ops-feedback",
    "model-serving",
    "external:web-push",
    "external:backup"
  ]
}
