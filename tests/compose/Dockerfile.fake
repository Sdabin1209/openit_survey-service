# 가짜 이웃 이미지(시험 전용, 모델 없음): 참조 추론 서버(model-runtime의 FakeModelSession 경로)와 가짜 게이트/수집 서버.
# 서비스 이미지와 같은 wheel로 라이브러리를 설치하고 tests/ 를 붙인다. scripts/smoke_compose.sh가 컨텍스트(build/fake-ctx)를 만든다.
# 기반 이미지는 태그가 아니라 digest로 고정한다(Docker 공식 권고, 공통 규칙 '빌드 때 고정'). 2026-11-05에 이 PC의 같은 태그 RepoDigest를 읽은 값이다. 올리는 법: `docker pull python:3.12-slim` 뒤 `docker image inspect python:3.12-slim --format '{{index .RepoDigests 0}}'` 값으로 이 한 곳을 바꾼다.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
COPY wheels /wheels
COPY requirements.lock /requirements.lock
RUN pip install --no-cache-dir -r /requirements.lock && pip install --no-cache-dir --no-deps /wheels/*.whl
COPY tests /opt/tests
RUN useradd --system --uid 10002 --no-create-home fake && mkdir /data && chown fake /data
USER fake
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/opt
