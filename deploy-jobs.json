{
  "jobs": [
    {
      "name": "session-purge",
      "argv": [
        "python",
        "-m",
        "survey_service",
        "purge"
      ],
      "idempotent": true,
      "secret_files": [
        "SURVEY_DATABASE_URL_FILE"
      ],
      "needs": [
        "postgres"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "backup",
      "argv": [
        "python",
        "-m",
        "survey_service",
        "backup"
      ],
      "idempotent": true,
      "secret_files": [
        "SURVEY_DATABASE_URL_FILE",
        "OPENIT_BACKUP_CREDENTIALS_FILE",
        "OPENIT_BACKUP_REPO_PASSWORD_FILE"
      ],
      "needs": [
        "postgres"
      ],
      "env": [
        "OPENIT_BACKUP_URL",
        "OPENIT_EGRESS_PROXY"
      ],
      "timeout_seconds": 1800
    },
    {
      "name": "restore",
      "argv": [
        "python",
        "-m",
        "survey_service",
        "restore"
      ],
      "idempotent": true,
      "secret_files": [
        "SURVEY_DATABASE_URL_FILE",
        "OPENIT_BACKUP_CREDENTIALS_FILE",
        "OPENIT_BACKUP_REPO_PASSWORD_FILE"
      ],
      "needs": [
        "postgres"
      ],
      "env": [
        "OPENIT_BACKUP_URL",
        "OPENIT_EGRESS_PROXY"
      ],
      "timeout_seconds": 1800
    }
  ]
}
